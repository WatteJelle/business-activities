@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL constraints for data sharing service: cancellation
hilo:cancellation1776260277487Shape a sh:NodeShape ;
    sh:targetNode hilo:cancellation1776260277487 ;
    rdfs:label "cancellation service shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/startStateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/endStateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ]  .

hilo:cancellation1776260277487StateShape a sh:NodeShape ;
    sh:targetClass <https://hilosemantics.com/State> ;
    rdfs:label "cancellation state shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/stateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ]  .

hilo:cancellation1776260277487StateTransitionShape a sh:NodeShape ;
    sh:targetClass <https://hilosemantics.com/Statetransition> ;
    rdfs:label "cancellation state transition shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/inputState> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/outputState> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/trigger> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/transServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ]  .

hilo:cancellation1776260277487DataSharingEventShape a sh:NodeShape ;
    sh:targetClass <https://hilosemantics.com/DataSharingEvent> ;
    rdfs:label "cancellation data sharing event shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/eventServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ]  .

