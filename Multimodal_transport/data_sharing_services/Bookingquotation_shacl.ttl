        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/startStateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
