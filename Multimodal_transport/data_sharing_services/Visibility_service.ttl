    <https://hilosemantics.com/stateServ> hilo:Visibilityservice-1773230132472  .

hilo:Cargoonitsway-1773232847983 a <https://hilosemantics.com/State>, owl:NamedIndividual ;
    rdfs:label "Cargo on its way" ;
    <https://hilosemantics.com/stateServ> hilo:Visibilityservice-1773230132472  .

<https://hilosemantics.com/Visibilityservice-1773230132472/state-transition/7551f458-2f97-49d1-a4b1-991a60cb8b18> a <https://hilosemantics.com/Statetransition>, owl:NamedIndividual ;
    rdfs:label "Cargo accepted" ;
    <https://hilosemantics.com/inputState> hilo:Cargoloaded-1773232857293 ;
    <https://hilosemantics.com/outputState> hilo:Cargoaccepted-1773232897517 ;
    <https://hilosemantics.com/trigger> hilo:eCMRavaiable-1773243081107 ;
    <https://hilosemantics.com/transServ> hilo:Visibilityservice-1773230132472 ;
    dspex:senderBehaviour [
        a dspex:SenderBehaviour ;
        dspex:preCondition "Cargo is loaded on truck" ;
        dspex:postCondition "Cargo has been inspected and truck has departed" ;
    ] ;
    dspex:recipientBehaviour [
        a dspex:RecipientBehaviour ;
        dspex:preCondition "Cargo is loaded on truck" ;
    ]  .

<https://hilosemantics.com/Visibilityservice-1773230132472/state-transition/5161664d-bb41-4872-bc3d-32fcf756dcf3> a <https://hilosemantics.com/Statetransition>, owl:NamedIndividual ;
