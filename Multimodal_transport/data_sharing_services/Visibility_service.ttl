    <https://hilosemantics.com/inputState> hilo:Orderconfirmed-1773231332182 ;
    <https://hilosemantics.com/outputState> hilo:Cargoloaded-1773232857293 ;
    <https://hilosemantics.com/trigger> hilo:Loadevent-1773233112099 ;
    <https://hilosemantics.com/transServ> hilo:Visibilityservice-1773230132472 ;
    dspex:senderBehaviour [
        a dspex:SenderBehaviour ;
        dspex:preCondition "Cargo and truck are present at the location" ;
        dspex:postCondition "Cargo loaded on truck." ;
    ] ;
    dspex:recipientBehaviour [
        a dspex:RecipientBehaviour ;
        dspex:preCondition "Cargo and truck are present at the location" ;
    ]  .

