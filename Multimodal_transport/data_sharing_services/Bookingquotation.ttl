# Data Sharing Pattern: Booking/quotation
<https://hilosemantics.com/Booking/quotation-1773230554216> a owl:Ontology, <https://hilosemantics.com/DataSharingService> ;
    rdfs:label "Booking/quotation" ;
    owl:versionInfo "1.0" ;
    <https://hilosemantics.com/startStateServ> hilo:BusinessServiceretrieved-1773232680412 ;
    <https://hilosemantics.com/endStateServ> hilo:Confirmedbooking-1773232706936  .

dspex:SenderBehaviour a owl:Class ;
    rdfs:label "Sender behaviour" ;
    rdfs:comment "Details of a state transition as executed by the sender of the trigger data sharing event: pre-condition, firing rule, warning and post-condition." .

dspex:RecipientBehaviour a owl:Class ;
    rdfs:label "Recipient behaviour" ;
    rdfs:comment "Details of a state transition as executed by the recipient of the trigger data sharing event: pre-condition, firing rule, warning and post-condition." .

dspex:preCondition a owl:AnnotationProperty ;
    rdfs:label "pre Condition" .

dspex:firingRule a owl:AnnotationProperty ;
    rdfs:label "firing Rule" .

dspex:warning a owl:AnnotationProperty ;
    rdfs:label "warning" .

dspex:postCondition a owl:AnnotationProperty ;
    rdfs:label "post Condition" .

dspex:role a owl:AnnotationProperty ;
    rdfs:label "role" .

dspex:principalRole a owl:AnnotationProperty ;
    rdfs:label "principal Role" .

dspex:rolePair a owl:AnnotationProperty ;
    rdfs:label "role Pair" .

dspex:senderRole a owl:AnnotationProperty ;
    rdfs:label "sender Role" .

dspex:internalTrigger a owl:AnnotationProperty ;
    rdfs:label "internal Trigger" .

dspex:initiatingRole a owl:AnnotationProperty ;
    rdfs:label "initiating Role" .

dspex:senderBehaviour a owl:ObjectProperty ;
    rdfs:label "sender behaviour" ;
    rdfs:domain <https://hilosemantics.com/Statetransition> ;
    rdfs:range dspex:SenderBehaviour .

dspex:recipientBehaviour a owl:ObjectProperty ;
    rdfs:label "recipient behaviour" ;
    rdfs:domain <https://hilosemantics.com/Statetransition> ;
    rdfs:range dspex:RecipientBehaviour .

