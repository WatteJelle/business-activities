    rdfs:comment "MARPOL 73/78\n            International Convention for the Prevention of Pollution from Ships, 1973, as modified by the Protocol of 1978 relating." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#ADU> a skos:Concept ;
    skos:prefLabel "ADU" ;
    rdfs:comment "JP, Japanese maritime safety agency dangerous goods regulation code\n            Regulation regarding the handling of dangerous goods on vessels issued by Japanese maritime safety agency." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#ADT> a skos:Concept ;
