<https://hilosemantics.com/Dangerousgoodsregulationcodes#UI> a skos:Concept ;
    skos:prefLabel "UI" ;
    rdfs:comment "UK IMO book\n            The United Kingdom (UK) version of the International Maritime Organisation (IMO) book on dangerous goods." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#RID> a skos:Concept ;
    skos:prefLabel "RID" ;
    rdfs:comment "Railroad dangerous goods book (RID)\n            International regulations concerning the international carriage of dangerous goods by rail.\nRID is the abbreviation of \"Reglement International concernant le transport des marchandises Dangereuses par chemin de fer\"." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#RGE> a skos:Concept ;
    skos:prefLabel "RGE" ;
    rdfs:comment "DE, RID and GGVE, Combined regulations for combined transport on rails\n            Combined German and European regulations for the transportation of dangerous goods on German and other European rails. RID means: Reglement International concernant le transport des marchandises Dangereuses par chemin de fer. GGVE means: Gefahrgutverordnung Eisenbahn." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#IMD> a skos:Concept ;
    skos:prefLabel "IMD" ;
    rdfs:comment "IMO IMDG code\n            Regulations regarding the transportation of dangerous goods on ocean-going vessels issued by the International Maritime Organization." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#ICA> a skos:Concept ;
    skos:prefLabel "ICA" ;
    rdfs:comment "IATA ICAO\n            Regulations covering the international transportation of dangerous goods issued by the International Air Transport Association and the International Civil Aviation Organization." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#GVS> a skos:Concept ;
    skos:prefLabel "GVS" ;
    rdfs:comment "DE, GGVS (Gefahrgutverordnung Strasse)\n            German regulation for the transportation of dangerous goods on road." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#GVE> a skos:Concept ;
    skos:prefLabel "GVE" ;
    rdfs:comment "DE, GGVE (Gefahrgutverordnung Eisenbahn)\n            German regulation for the transportation of dangerous goods on rail." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#COM> a skos:Concept ;
    skos:prefLabel "COM" ;
    rdfs:comment "DE, ADR, RID, GGVS and GGVE - Combined regulations for combined transport\n            Combined German and European regulations for the combined transportation of dangerous goods on German and other European roads and rails. ADR means: Accord Europeen relatif au transport international des marchandises Dangereuse par Route. RID means: Reglement International concernant le transport des marchandises Dangereuses par chemin de fer. GGVS means: Gefahrgutverordnung Strasse. GGVE means: Gefahrgutverordnung Eisenbahn." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#CFR> a skos:Concept ;
    skos:prefLabel "CFR" ;
    rdfs:comment "US, 49 Code of federal regulations\n            United States federal regulations issued by the US Department of transportation covering the domestic transportation of dangerous goods by truck, rail, water and air." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#ARD> a skos:Concept ;
    skos:prefLabel "ARD" ;
    rdfs:comment "DE, ARD and RID - Combined regulations for combined transport\n            Combined European regulations for the combined transportation of dangerous goods on roads and rails. ARD means: Autorisation de transport par Route de matieres dangereuses. RID means: Reglement International concernant le transport des marchandises Dangereuses par chemin de fer." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#ANR> a skos:Concept ;
    skos:prefLabel "ANR" ;
    rdfs:comment "ADNR, Autorisation de transport de matieres Dangereuses pour la Navigation sur le Rhin\n            Regulations for dangerous goods transportation on the Rhine." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#AGS> a skos:Concept ;
    skos:prefLabel "AGS" ;
    rdfs:comment "DE, ADR and GGVS combined regulations for combined transport\n            Combined German and European regulations for the transportation of dangerous goods on German and other European roads. ADR means: Accord Europeen relatif au Transport international des marchandises Dangereuses par Route. GGVS means: Gefahrgutverordnung Strasse." ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#AEB> a skos:Concept ;
    skos:prefLabel "AEB" ;
    rdfs:comment "MARPOL Annex I\n            The International Convention for the Prevention of Pollution from Ships (MARPOL) - Prevention of Pollution by Oil" ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#AEA> a skos:Concept ;
