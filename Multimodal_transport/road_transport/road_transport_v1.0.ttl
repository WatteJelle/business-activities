    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#991> a skos:Concept ;
    skos:prefLabel "991" ;
    rdfs:comment "Government contract\n            Document/message describing a contract with a government authority." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#990> a skos:Concept ;
    skos:prefLabel "990" ;
    rdfs:comment "End use authorization\n            Document issued by Customs granting the end-use Customs procedure." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#979> a skos:Concept ;
    skos:prefLabel "979" ;
    rdfs:comment "Transfrontier waste shipment movement document\n            Document certified by the carriers and the consignee to be used for the international carriage of waste." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#978> a skos:Concept ;
    skos:prefLabel "978" ;
    rdfs:comment "Transfrontier waste shipment authorization\n            Document containing the authorization from the relevant authority for the international carriage of waste. Syn: Transfrontier waste shipment permit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#977> a skos:Concept ;
    skos:prefLabel "977" ;
    rdfs:comment "NATO transit document\n            Customs transit document for the carriage of shipments of the NATO armed forces under Customs supervision." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#976> a skos:Concept ;
    skos:prefLabel "976" ;
    rdfs:comment "Container transfer note\n            Document for the carriage of containers. Syn: transfer note." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#975> a skos:Concept ;
    skos:prefLabel "975" ;
    rdfs:comment "Proof of transit declaration\n            A document providing proof that a transit declaration has been accepted." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#974> a skos:Concept ;
    skos:prefLabel "974" ;
    rdfs:comment "Duty suspended goods\n            Document giving details for the carriage of excisable goods on a duty-suspended basis." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#972> a skos:Concept ;
    skos:prefLabel "972" ;
    rdfs:comment "Rail consignment note forwarder copy\n            Document which is a copy of the rail consignment note printed especially for the need of the forwarder." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#971> a skos:Concept ;
    skos:prefLabel "971" ;
    rdfs:comment "Transit Conveyor Document\n            Document for a course of transit used for a carrier who is neither the carrier at the beginning nor the arrival. The transit carrier can directly invoice the expenses for its part of the transport." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#970> a skos:Concept ;
    skos:prefLabel "970" ;
    rdfs:comment "Wagon report\n            Document which contains consignment information concerning the wagons and their lading in a case of a multiple wagon consignment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#966> a skos:Concept ;
    skos:prefLabel "966" ;
    rdfs:comment "Quota prior allocation certificate\n            Document/message issued by the competent body for prior allocation of a quota." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#965> a skos:Concept ;
    skos:prefLabel "965" ;
    rdfs:comment "Tax calculation/confirmation response (Customs)\n            Tax calculation/confirmation response message to permit the transfer of data from Customs to the transmitter of the previous message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#964> a skos:Concept ;
    skos:prefLabel "964" ;
    rdfs:comment "Package response (Customs)\n            Package response message to permit the transfer of data from Customs to the transmitter of the previous message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#963> a skos:Concept ;
    skos:prefLabel "963" ;
    rdfs:comment "Error response (Customs)\n            Error response message to permit the transfer of data from Customs to the transmitter of the previous message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#962> a skos:Concept ;
    skos:prefLabel "962" ;
    rdfs:comment "Document response (Customs)\n            Document response message to permit the transfer of data from Customs to the transmitter of the previous message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#961> a skos:Concept ;
    skos:prefLabel "961" ;
    rdfs:comment "General response (Customs)\n            General response message to permit the transfer of data from Customs to the transmitter of the previous message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#960> a skos:Concept ;
    skos:prefLabel "960" ;
    rdfs:comment "Single administrative document\n            A set of documents, replacing the various (national) forms for Customs declaration within the EC, implemented on 01-01-1988." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#955> a skos:Concept ;
    skos:prefLabel "955" ;
    rdfs:comment "ATA carnet\n            International Customs document (Admission Temporaire / Temporary Admission) which, issued under the terms of the ATA Convention (1961), incorporates an internationally valid guarantee and may be used, in lieu of national Customs documents and as security for import duties and taxes, to cover the temporary admission of goods and, where appropriate, the transit of goods. If accepted for controlling the temporary export and reimport of goods, international guarantee does not apply (CCC)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#954> a skos:Concept ;
    skos:prefLabel "954" ;
    rdfs:comment "EUR 1 certificate of origin\n            Customs certificate used in preferential goods interchanges between EC countries and EC external countries." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#953> a skos:Concept ;
    skos:prefLabel "953" ;
    rdfs:comment "EC carnet\n            EC customs transit document issued by EC customs authorities for transit and/or temporary user of goods within the EC." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#952> a skos:Concept ;
    skos:prefLabel "952" ;
    rdfs:comment "TIR carnet\n            International Customs document (International Transit by Road), issued by a guaranteeing association approved by the Customs authorities, under the cover of which goods are carried, in most cases under Customs seal, in road vehicles and/or containers in compliance with the requirements of the Customs TIR Convention of the International Transport of Goods under cover of TIR Carnets (UN/ECE)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#951> a skos:Concept ;
    skos:prefLabel "951" ;
    rdfs:comment "TIF form\n            International Customs transit document by which the sender declares goods for carriage by rail in accordance with the provisions of the 1952 International Convention to facilitate the crossing of frontiers for goods carried by rail (TIF Convention of UIC)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#950> a skos:Concept ;
    skos:prefLabel "950" ;
    rdfs:comment "Goods declaration for Customs transit\n            Document/message by which the sender declares goods for Customs transit according to Annex E.1 (concerning Customs transit) to the Kyoto convention (CCC)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#948> a skos:Concept ;
    skos:prefLabel "948" ;
    rdfs:comment "Declaration of Conformity\n            A self-issued document in which the manufacturer or supplier declares that their product, process, or service meets the specified standards or regulatory requirements." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#941> a skos:Concept ;
    skos:prefLabel "941" ;
    rdfs:comment "Embargo permit\n            Document/message giving the permission to export specified goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#940> a skos:Concept ;
    skos:prefLabel "940" ;
    rdfs:comment "Tax demand\n            Document/message containing the demand of tax." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#939> a skos:Concept ;
    skos:prefLabel "939" ;
    rdfs:comment "Environmental, Social, and Governance (ESG) Report\n            A document commonly addressed to investors and regulators, containing standardized data to assess corporate performance and risk, detailing a company's impact and efforts regarding environmental and social issues, as well as corporate board and management." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#938> a skos:Concept ;
    skos:prefLabel "938" ;
    rdfs:comment "Tax declaration (general)\n            Document/message containing a general tax declaration." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#937> a skos:Concept ;
    skos:prefLabel "937" ;
    rdfs:comment "Tax declaration (value added tax)\n            Document/message in which an importer states the pertinent information required by the competent body for assessment of value-added tax." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#936> a skos:Concept ;
    skos:prefLabel "936" ;
    rdfs:comment "Customs declaration (post parcels)\n            Document/message which, according to Article 106 of the \"Agreement concerning Postal Parcels\" under the UPU Convention, must accompany post parcels and in which the contents of such parcels are specified." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#935> a skos:Concept ;
    skos:prefLabel "935" ;
    rdfs:comment "Customs invoice\n            Document/message required by the Customs in an importing country in which an exporter states the invoice or other price (e.g. selling price, price of identical goods), and specifies costs for freight, insurance and packing, etc., terms of delivery and payment, for the purpose of determining the Customs value in the importing country of goods consigned to that country." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#934> a skos:Concept ;
    skos:prefLabel "934" ;
    rdfs:comment "Value declaration\n            Document/message in which a declarant (importer) states the invoice or other price (e.g. selling price, price of identical goods), and specifies costs for freight, insurance and packing, etc., terms of delivery and payment, any relationship with the trading partner, etc., for the purpose of determining the Customs value of goods imported." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#933> a skos:Concept ;
    skos:prefLabel "933" ;
    rdfs:comment "Cargo declaration (arrival)\n            Generic term, sometimes referred to as Freight declaration, applied to the documents providing the particulars required by the Customs concerning the cargo (freight) carried by commercial means of transport (CCC)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#932> a skos:Concept ;
    skos:prefLabel "932" ;
    rdfs:comment "Customs delivery note\n            Document/message whereby a Customs authority releases goods under its control to be placed at the disposal of the party concerned. Synonym: Customs release note." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#931> a skos:Concept ;
    skos:prefLabel "931" ;
    rdfs:comment "Customs immediate release declaration\n            Document/message issued by an importer notifying Customs that goods have been removed from an importing means of transport to the importer's premises under a Customs-approved arrangement for immediate release, or requesting authorization to do so." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#930> a skos:Concept ;
    skos:prefLabel "930" ;
    rdfs:comment "Goods declaration for home use\n            Document/message by which goods are declared for import Customs clearance according to Annex B.1 (concerning clearance for home use) to the Kyoto convention (CCC)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#929> a skos:Concept ;
    skos:prefLabel "929" ;
    rdfs:comment "Goods declaration for importation\n            Document/message by which goods are declared for import Customs clearance [sister entry of 830]." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#927> a skos:Concept ;
    skos:prefLabel "927" ;
    rdfs:comment "Exchange control declaration (import)\n            Document/message completed by an importer/buyer as a means for the competent body to control that a trade transaction for which foreign exchange has been allocated has been executed and that money has been transferred in accordance with the conditions of payment and the exchange control regulations in force." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#926> a skos:Concept ;
    skos:prefLabel "926" ;
    rdfs:comment "Foreign exchange permit\n            Document/message issued by the competent body authorizing an importer/buyer to transfer an amount of foreign exchange to an exporter/seller in payment for goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#925> a skos:Concept ;
    skos:prefLabel "925" ;
    rdfs:comment "Application for exchange allocation\n            Document/message whereby an importer/buyer requests the competent body to allocate an amount of foreign exchange to be transferred to an exporter/seller in payment for goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#917> a skos:Concept ;
    skos:prefLabel "917" ;
    rdfs:comment "Receipt (Customs)\n            Receipt for Customs duty/tax/fee paid." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#916> a skos:Concept ;
    skos:prefLabel "916" ;
    rdfs:comment "Related document\n            Document that has a relationship with the stated document/message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#915> a skos:Concept ;
    skos:prefLabel "915" ;
    rdfs:comment "Customs declaration without item detail\n            CUSDEC transmission that does not include data from the item detail section of the message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#914> a skos:Concept ;
    skos:prefLabel "914" ;
    rdfs:comment "Customs declaration with commercial and item detail\n            CUSDEC transmission that includes data from both the commercial detail and item detail sections of the message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#913> a skos:Concept ;
    skos:prefLabel "913" ;
    rdfs:comment "Customs declaration without commercial detail\n            CUSDEC transmission that does not include data from the commercial detail section of the message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#912> a skos:Concept ;
    skos:prefLabel "912" ;
    rdfs:comment "Transport Means and Goods Release Message.\n            Message to provide the releasing information of transport means and goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#911> a skos:Concept ;
    skos:prefLabel "911" ;
    rdfs:comment "Import licence\n            Document/message issued by the competent body in accordance with import regulations in force, by which authorization is granted to a named party to import either a limited quantity of designated articles or an unlimited quantity of such articles during a limited period, under conditions specified in the document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#910> a skos:Concept ;
    skos:prefLabel "910" ;
    rdfs:comment "Import licence, application for\n            Document/message in which an interested party applies to the competent body for authorization to import either a limited quantity of articles subject to import restrictions, or an unlimited quantity of such articles during a limited period, and specifies the kind of articles, their origin and value, etc." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#909> a skos:Concept ;
    skos:prefLabel "909" ;
    rdfs:comment "Goods Loading Message\n            Message to provide the information of goods loading." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#908> a skos:Concept ;
    skos:prefLabel "908" ;
    rdfs:comment "Tally Message\n            Message to provide the information of goods tallying." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#907> a skos:Concept ;
    skos:prefLabel "907" ;
    rdfs:comment "Arrival Report Message\n            Message to provide the arrival information of transport means and goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#906> a skos:Concept ;
    skos:prefLabel "906" ;
    rdfs:comment "Transport Means Actual Information Message\n            Message to provide the actual information about ships, trains, vehicles and aircrafts arrival at the destination." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#905> a skos:Concept ;
    skos:prefLabel "905" ;
    rdfs:comment "Transport Means Forecast Information Message\n            Message to provide the forecast information about ships, trains, vehicles and aircrafts arrival at the destination." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#904> a skos:Concept ;
    skos:prefLabel "904" ;
    rdfs:comment "Sustainability Inspection response\n            Document/message reporting the results of a sustainability inspection." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#903> a skos:Concept ;
    skos:prefLabel "903" ;
    rdfs:comment "Sustainability Inspection request\n            Document/message requesting a sustainability inspection." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#902> a skos:Concept ;
    skos:prefLabel "902" ;
    rdfs:comment "Sustainability data response\n            Document/Message returned as an answer to a question regarding sustainability." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#901> a skos:Concept ;
    skos:prefLabel "901" ;
    rdfs:comment "Delivery verification certificate\n            Document/message whereby an official authority (Customs or governmental) certifies that goods have been delivered." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#900> a skos:Concept ;
    skos:prefLabel "900" ;
    rdfs:comment "Sustainability data request\n            Document/message requesting information based on defined criteria regarding sustainability." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#899> a skos:Concept ;
    skos:prefLabel "899" ;
    rdfs:comment "Traceability event declaration\n            Document/message declaring a traceability event." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#898> a skos:Concept ;
    skos:prefLabel "898" ;
    rdfs:comment "Pre-packed cross docking consignment order\n            A consignment order requesting the supply of products packed according to the final delivery point which will be moved across a dock in a distribution centre without further handling." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#897> a skos:Concept ;
    skos:prefLabel "897" ;
    rdfs:comment "Transit certificate of approval\n            Certificate of approval for vehicles and containers used to transit goods under customs seals." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#896> a skos:Concept ;
    skos:prefLabel "896" ;
    rdfs:comment "INTRASTAT declaration\n            Document/message in which a declarant provides information about goods required by the body responsible for the collection of trade statistics." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#895> a skos:Concept ;
    skos:prefLabel "895" ;
    rdfs:comment "Statistical document, export\n            Document/message in which an exporter provides information about exported goods required by the body responsible for the collection of international trade statistics." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#894> a skos:Concept ;
    skos:prefLabel "894" ;
    rdfs:comment "Purchase Order Financing Request Cancellation\n            Document enabling the Financing Requestor to request the First Agent to cancel a previously sent purchase order financing request." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#893> a skos:Concept ;
    skos:prefLabel "893" ;
    rdfs:comment "Purchase Order Financing Request Status\n            Document enabling the First Agent to notify the Financing Requestor of the status of a purchase order financing request or the status of a purchase order financing cancellation request previously sent by the Financial Requestor itself." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#892> a skos:Concept ;
    skos:prefLabel "892" ;
    rdfs:comment "Purchase Order Financing Request\n            Document enabling the Financing Requestor to initiate the financing process by the First Agent." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#891> a skos:Concept ;
    skos:prefLabel "891" ;
    rdfs:comment "AEO Certificate Full\n            Certificate issued to business that fulfils specified criteria to both AEO Certificate of Security and/or Safety and AEO Certificate of Conformity or Compliance by a national AEO recognized program (e.g. AEO-Customs Simplifications/Security and Safety (AEOC/AEOS) - Regulation(EU) No 952/2013)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#890> a skos:Concept ;
    skos:prefLabel "890" ;
    rdfs:comment "Dangerous goods declaration\n            (1115) Document/message issued by a consignor in accordance with applicable conventions or regulations, describing hazardous goods or materials for transport purposes, and stating that the latter have been packed and labelled in accordance with the provisions of the relevant conventions or regulations." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#879> a skos:Concept ;
    skos:prefLabel "879" ;
    rdfs:comment "AEO Certificate of Conformity or Compliance\n            Certificate issued to business that fulfils specified criteria for compliance with tax and customs obligations, as well as financial solvency by a national AEO recognized program (e.g. AEO-Customs Simplifications (AEOC) - Regulation (EU) No 952/2013)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#878> a skos:Concept ;
    skos:prefLabel "878" ;
    rdfs:comment "AEO Certificate of Security and/or Safety\n            Certificate issued to business that fulfils specified criteria applied to the security and safety of the logistics chain in the flow of foreign trade operations by a national AEO recognized program (e.g. AEO-Security and Safety (AEOS) - Regulation (EU) No 952/2013)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#877> a skos:Concept ;
    skos:prefLabel "877" ;
    rdfs:comment "Final construction invoice\n            Invoice concluding all previous partial invoices and partial final construction invoices in the context of a specific construction project." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#876> a skos:Concept ;
    skos:prefLabel "876" ;
    rdfs:comment "Partial final construction invoice\n            Invoice concluding all previous partial construction invoices of a completed partial rendered service in the context of a specific construction project." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#875> a skos:Concept ;
    skos:prefLabel "875" ;
    rdfs:comment "Partial construction invoice\n            Partial invoice in the context of a specific construction project." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#874> a skos:Concept ;
    skos:prefLabel "874" ;
    rdfs:comment "Conveyance declaration\n            Declaration of the conveyance to a public authority." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#873> a skos:Concept ;
    skos:prefLabel "873" ;
    rdfs:comment "Transport equipment movement report, partial\n            A partial transport equipment movement report, containing only a selected part of the movements of transport equipment for a vessel in a port." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#872> a skos:Concept ;
    skos:prefLabel "872" ;
    rdfs:comment "Risk analysis\n            Document specifying the analysis of risks." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#871> a skos:Concept ;
    skos:prefLabel "871" ;
    rdfs:comment "Inquiry mandate\n            Document expressing the mandate of a client for an inquiry service by the mandated provider." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#870> a skos:Concept ;
    skos:prefLabel "870" ;
    rdfs:comment "Consular invoice\n            Document/message to be prepared by an exporter in his country and presented to a diplomatic representation of the importing country for endorsement and subsequently to be presented by the importer in connection with the import of the goods described therein." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#869> a skos:Concept ;
    skos:prefLabel "869" ;
    rdfs:comment "Exclusive brokerage mandate\n            Document expressing the mandate of a client for a service only by the mandated broker." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#868> a skos:Concept ;
    skos:prefLabel "868" ;
    rdfs:comment "Data protection regulations statement\n            Document specifying the terms of data protection regulations." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#867> a skos:Concept ;
    skos:prefLabel "867" ;
    rdfs:comment "Introductory letter\n            A letter of introduction attached to, or accompanying another document such as an insurance policy." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#866> a skos:Concept ;
    skos:prefLabel "866" ;
    rdfs:comment "Video\n            Document consisting of a video." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#865> a skos:Concept ;
    skos:prefLabel "865" ;
    rdfs:comment "Certificate of origin form GSP\n            Specific form of certificate of origin for goods qualifying for preferential treatment under the generalized system of preferences (includes a combined declaration of origin and certificate, form A)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#864> a skos:Concept ;
    skos:prefLabel "864" ;
    rdfs:comment "Preference certificate of origin\n            Document/message describing a certificate of origin meeting the requirements for preferential treatment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#863> a skos:Concept ;
    skos:prefLabel "863" ;
    rdfs:comment "Regional appellation certificate\n            Certificate drawn up in accordance with the rules laid down by an authority or approved body, certifying that the goods described therein qualify for a designation specific to the given region (e.g. champagne, port wine, Parmesan cheese)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#862> a skos:Concept ;
    skos:prefLabel "862" ;
    rdfs:comment "Declaration of origin\n            Appropriate statement as to the origin of the goods, made in connection with their exportation by the manufacturer, producer, supplier, exporter or other competent person on the Commercial invoice or any other document relating to the goods (CCC)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#861> a skos:Concept ;
    skos:prefLabel "861" ;
    rdfs:comment "Certificate of origin\n            Document/message identifying goods, in which the authority or body authorized to issue it certifies expressly that the goods to which the certificate relates originate in a specific country. The word \"country\" may include a group of countries, a region or a part of a country. This certificate may also include a declaration by the manufacturer, producer, supplier, exporter or other competent person." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#860> a skos:Concept ;
    skos:prefLabel "860" ;
    rdfs:comment "Certificate of origin, application for\n            Document/message submitted to a competent body by an interested party requesting a Certificate of origin to be issued in accordance with relevant criteria, and on the basis of evidence of the origin of the goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#859> a skos:Concept ;
    skos:prefLabel "859" ;
    rdfs:comment "Audio\n            Document consisting of an audio recording (e.g. a telephone conversation or alike)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#858> a skos:Concept ;
    skos:prefLabel "858" ;
    rdfs:comment "Image\n            Document consisting of an image." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#857> a skos:Concept ;
    skos:prefLabel "857" ;
    rdfs:comment "Vehicle aboard document\n            Document which must be aboard the vehicle." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#856> a skos:Concept ;
    skos:prefLabel "856" ;
    rdfs:comment "Inspection certificate\n            Document/message issued by a competent body evidencing that the goods described therein have been inspected in accordance with national or international standards, in conformity with legislation in the country in which the inspection is required, or as specified in the contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#855> a skos:Concept ;
    skos:prefLabel "855" ;
    rdfs:comment "Application for inspection certificate\n            Document/message submitted to a competent body by a party requesting an Inspection certificate to be issued in accordance with national or international standards, or conforming to legislation in the country in which it is required, or as specified in the contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#854> a skos:Concept ;
    skos:prefLabel "854" ;
    rdfs:comment "Court judgment\n            Document specifying a judgment of a court." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#853> a skos:Concept ;
    skos:prefLabel "853" ;
    rdfs:comment "Veterinary certificate\n            Document/message issued by the competent authority in the exporting country evidencing that live animals or birds are not infested or infected with disease, and giving details regarding their provenance, and of vaccinations and other treatment to which they have been subjected." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#852> a skos:Concept ;
    skos:prefLabel "852" ;
    rdfs:comment "Sanitary certificate\n            Document/message issued by the competent authority in the exporting country evidencing that alimentary and animal products, including dead animals, are fit for human consumption, and giving details, when relevant, of controls undertaken." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#851> a skos:Concept ;
    skos:prefLabel "851" ;
    rdfs:comment "Phytosanitary certificate\n            A message/doucment consistent with the model for certificates of the IPPC, attesting that a consignment meets phytosanitary import requirements." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#850> a skos:Concept ;
    skos:prefLabel "850" ;
    rdfs:comment "Application for phytosanitary certificate\n            Document/message submitted to a competent body by party requesting a Phytosanitary certificate to be issued." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#849> a skos:Concept ;
    skos:prefLabel "849" ;
    rdfs:comment "Summons\n            Document specifying a summons to court." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#848> a skos:Concept ;
    skos:prefLabel "848" ;
    rdfs:comment "Legal action\n            Document specifying a legal action at court." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#847> a skos:Concept ;
    skos:prefLabel "847" ;
    rdfs:comment "Out of court settlement\n            Document which specifies an out of court settlement." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#846> a skos:Concept ;
    skos:prefLabel "846" ;
    rdfs:comment "Amicable agreement\n            Document specifying an amicable agreement." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#845> a skos:Concept ;
    skos:prefLabel "845" ;
    rdfs:comment "Communication from opposite party\n            Document containing a communication from the opposite party, such as in legal action." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#844> a skos:Concept ;
    skos:prefLabel "844" ;
    rdfs:comment "Calculation note\n            Document detailing a calculation, such as an invoice calculation or a costs calculation." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#843> a skos:Concept ;
    skos:prefLabel "843" ;
    rdfs:comment "Witness report\n            Document containing a report of a witness." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#842> a skos:Concept ;
    skos:prefLabel "842" ;
    rdfs:comment "Medical certificate\n            Document certifying a medical condition." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#841> a skos:Concept ;
    skos:prefLabel "841" ;
    rdfs:comment "Goods control certificate\n            Document/message issued by a competent body evidencing the quality of the goods described therein, in accordance with national or international standards, or conforming to legislation in the importing country, or as specified in the contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#840> a skos:Concept ;
    skos:prefLabel "840" ;
    rdfs:comment "Application for goods control certificate\n            Document/message submitted to a competent body by party requesting a Goods control certificate to be issued in accordance with national or international standards, or conforming to legislation in the importing country, or as specified in the contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#839> a skos:Concept ;
    skos:prefLabel "839" ;
    rdfs:comment "Physician report\n            Report issued by a medical doctor." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#838> a skos:Concept ;
    skos:prefLabel "838" ;
    rdfs:comment "Direct debit authorisation\n            Document giving the addressee the right to debit from an account of the authorizing party." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#837> a skos:Concept ;
    skos:prefLabel "837" ;
    rdfs:comment "Third party payment report\n            Report about payments done towards a third party." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#836> a skos:Concept ;
    skos:prefLabel "836" ;
    rdfs:comment "Insured party payment report\n            Report about payments done towards an insured party." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#835> a skos:Concept ;
    skos:prefLabel "835" ;
    rdfs:comment "Certificate of paid insurance premium\n            Document certifying the payment of the insurance premium." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#834> a skos:Concept ;
    skos:prefLabel "834" ;
    rdfs:comment "Payment receipt confirmation\n            Document confirming the receipt of a payment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#833> a skos:Concept ;
    skos:prefLabel "833" ;
    rdfs:comment "Cargo declaration (departure)\n            Generic term, sometimes referred to as Freight declaration, applied to the documents providing the particulars required by the Customs concerning the cargo (freight) carried by commercial means of transport (CCC)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#832> a skos:Concept ;
    skos:prefLabel "832" ;
    rdfs:comment "Accounting statement\n            Document specifying an accounting statement." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#831> a skos:Concept ;
    skos:prefLabel "831" ;
    rdfs:comment "Claim history certificate\n            Document which certifies the history of claims." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#830> a skos:Concept ;
    skos:prefLabel "830" ;
    rdfs:comment "Goods declaration for exportation\n            Document/message by which goods are declared for export Customs clearance, conforming to the layout key set out at Appendix I to Annex C.1 concerning outright exportation to the Kyoto convention (CCC). Within a Customs union, \"for despatch\" may have the same meaning as \"for exportation\"." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#829> a skos:Concept ;
    skos:prefLabel "829" ;
    rdfs:comment "Valuation report\n            Document reporting a valuation." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#828> a skos:Concept ;
    skos:prefLabel "828" ;
    rdfs:comment "Refusal of claim\n            Document stating the refusal of a claim." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#827> a skos:Concept ;
    skos:prefLabel "827" ;
    rdfs:comment "Close of claim\n            Document reporting the closing of a claim file." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#826> a skos:Concept ;
    skos:prefLabel "826" ;
    rdfs:comment "Guarantee of cost acceptance\n            Document certifying the guarantee of the document issuer that he will pay for costs of the addressee, e.g. the costs for repairing a vehicle." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#825> a skos:Concept ;
    skos:prefLabel "825" ;
    rdfs:comment "Despatch note model T2L\n            Ascertainment that the declared goods were originally produced in an European Union (EU) country. May only be used for goods that are loaded on one single means of transport in one single departure point for one single delivery point." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#824> a skos:Concept ;
    skos:prefLabel "824" ;
    rdfs:comment "Re-sending consignment note\n            Rail consignment note prepared by the consignor for the facilitation of an eventual return to the origin of the goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#823> a skos:Concept ;
    skos:prefLabel "823" ;
    rdfs:comment "Control document T5\n            Control document (export declaration) used particularly in case of re-sending without use with only VAT collection, refusal, unconformity with contract etc." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#822> a skos:Concept ;
    skos:prefLabel "822" ;
    rdfs:comment "Despatch note model T2\n            Ascertainment that the declared goods were originally produced in an European Union (EU) country." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#821> a skos:Concept ;
    skos:prefLabel "821" ;
    rdfs:comment "Despatch note model T1\n            Transit declaration for goods circulating under internal community transit procedures (between European Union (EU) countries)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#820> a skos:Concept ;
    skos:prefLabel "820" ;
    rdfs:comment "Despatch note model T\n            European community transit declaration." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#819> a skos:Concept ;
    skos:prefLabel "819" ;
    rdfs:comment "Loss statement\n            Document specifying the value of a loss." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#818> a skos:Concept ;
    skos:prefLabel "818" ;
    rdfs:comment "Assessment report\n            Document reporting an assessment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#817> a skos:Concept ;
    skos:prefLabel "817" ;
    rdfs:comment "Claim notification\n            Document notifying a claim." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#816> a skos:Concept ;
    skos:prefLabel "816" ;
    rdfs:comment "Group pension commitment information\n            Information document for the group pension commitment to an individual person." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#815> a skos:Concept ;
    skos:prefLabel "815" ;
    rdfs:comment "Insured status report\n            Document reporting (e.g. annually) to the insured the actual details of an insurance contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#814> a skos:Concept ;
    skos:prefLabel "814" ;
    rdfs:comment "US, FATCA statement\n            Statement regarding the Foreign Account Tax Compliance Act (FATCA) of the United States of America." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#813> a skos:Concept ;
    skos:prefLabel "813" ;
    rdfs:comment "Declaration of final beneficiary\n            Declaration document to identify the final beneficiary of an asset." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#812> a skos:Concept ;
    skos:prefLabel "812" ;
    rdfs:comment "Exchange control declaration, export\n            Document/message completed by an exporter/seller as a means whereby the competent body may control that the amount of foreign exchange accrued from a trade transaction is repatriated in accordance with the conditions of payment and exchange control regulations in force." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#811> a skos:Concept ;
    skos:prefLabel "811" ;
    rdfs:comment "Export licence\n            Permit issued by a government authority permitting exportation of a specified commodity subject to specified conditions as quantity, country of destination, etc. Synonym: Embargo permit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#810> a skos:Concept ;
    skos:prefLabel "810" ;
    rdfs:comment "Export licence, application for\n            Application for a permit issued by a government authority permitting exportation of a specified commodity subject to specified conditions as quantity, country of destination, etc." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#799> a skos:Concept ;
    skos:prefLabel "799" ;
    rdfs:comment "Ship's stores declaration\n            Declaration to Customs regarding the contents of the ship's stores (equivalent to IMO FAL 3) i.e. goods intended for consumption by passengers/crew on board vessels, aircraft or trains, whether or not sold or landed; goods necessary for operation/maintenance of conveyance, including fuel/lubricants, excluding spare parts/equipment (IMO)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#798> a skos:Concept ;
    skos:prefLabel "798" ;
    rdfs:comment "Certificate of registry\n            Official certificate stating the vessel's registry." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#797> a skos:Concept ;
    skos:prefLabel "797" ;
    rdfs:comment "Maritime declaration of health\n            Document certifying the health condition on board a vessel, valid to a specified date." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#796> a skos:Concept ;
    skos:prefLabel "796" ;
    rdfs:comment "Derat document\n            Document certifying that a ship is free of rats, valid to a specified date." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#795> a skos:Concept ;
    skos:prefLabel "795" ;
    rdfs:comment "Loadline document\n            Document specifying the limit of a ship's legal submersion under various conditions." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#794> a skos:Concept ;
    skos:prefLabel "794" ;
    rdfs:comment "Civil liability for oil certificate\n            Document declaring a ship owner's liability for oil propelling or carried on a vessel." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#793> a skos:Concept ;
    skos:prefLabel "793" ;
    rdfs:comment "Safety of equipment certificate\n            Document certifying the safety of a ship's equipment to a specified date." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#792> a skos:Concept ;
    skos:prefLabel "792" ;
    rdfs:comment "Safety of radio certificate\n            Document certifying the safety of a ship's radio facilities to a specified date." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#791> a skos:Concept ;
    skos:prefLabel "791" ;
    rdfs:comment "Safety of ship certificate\n            Document certifying a ship's safety to a specified date." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#790> a skos:Concept ;
    skos:prefLabel "790" ;
    rdfs:comment "Advice of collection\n            (1030) Document that is joined to the transport or sent by separate means, giving to the departure rail organization the proof that the cash-on delivery amount has been encashed by the arrival rail organization before reimbursement of the consignor." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#789> a skos:Concept ;
    skos:prefLabel "789" ;
    rdfs:comment "Charges note\n            Document used by the rail organization to indicate freight charges or additional charges in each case where the departure station is not able to calculate the charges for the total voyage (e.g. tariff not yet updated, part of voyage not covered by the tariff). This document must be considered as joined to the transport." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#788> a skos:Concept ;
    skos:prefLabel "788" ;
    rdfs:comment "Container manifest (unit packing list)\n            Document/message specifying the contents of particular freight containers or other transport units, prepared by the party responsible for their loading into the container or unit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#787> a skos:Concept ;
    skos:prefLabel "787" ;
    rdfs:comment "Bordereau\n            Document/message used in road transport, listing the cargo carried on a road vehicle, often referring to appended copies of Road consignment note." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#786> a skos:Concept ;
    skos:prefLabel "786" ;
    rdfs:comment "Freight manifest\n            Document/message containing the same information as a cargo manifest, and additional details on freight amounts, charges, etc." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#785> a skos:Concept ;
    skos:prefLabel "785" ;
    rdfs:comment "Cargo manifest\n            Listing of goods comprising the cargo carried in a means of transport or in a transport-unit. The cargo manifest gives the commercial particulars of the goods, such as transport document numbers, consignors, consignees, shipping marks, number and kind of packages and descriptions and quantities of the goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#784> a skos:Concept ;
    skos:prefLabel "784" ;
    rdfs:comment "Delivery notice (goods)\n            Notification in writing, sent by the carrier to the sender, to inform him at his request of the actual date of delivery of the goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#783> a skos:Concept ;
    skos:prefLabel "783" ;
    rdfs:comment "Notice of circumstances preventing transport (goods)\n            Request made by the carrier to the sender, or, the consignee as the case may be, for instructions as to the disposal of the goods when circumstances prevent transport before departure or en route, after acceptance of the consignment concerned." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#782> a skos:Concept ;
    skos:prefLabel "782" ;
    rdfs:comment "Notice of circumstances preventing delivery (goods)\n            Request made by the carrier to the sender, or, as the case may be, the consignee, for instructions as to the disposal of the consignment when circumstances prevent delivery and the return of the goods has not been requested by the consignor in the transport document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#781> a skos:Concept ;
    skos:prefLabel "781" ;
    rdfs:comment "Arrival notice (goods)\n            Notification from the carrier to the consignee in writing, by telephone or by any other means (express letter, message, telegram, etc.) informing him that a consignment addressed to him is being or will shortly be held at his disposal at a specified point in the place of destination." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#780> a skos:Concept ;
    skos:prefLabel "780" ;
    rdfs:comment "Freight invoice\n            Document/message issued by a transport operation specifying freight costs and charges incurred for a transport operation and stating conditions of payment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#779> a skos:Concept ;
    skos:prefLabel "779" ;
    rdfs:comment "Questionnaire\n            Document consisting of a series of questions." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#778> a skos:Concept ;
    skos:prefLabel "778" ;
    rdfs:comment "Group insurance rules\n            Document stating the rules of a group insurance contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#777> a skos:Concept ;
    skos:prefLabel "777" ;
    rdfs:comment "Specific contract conditions\n            Document specifying the individual conditions or clauses applying to a specific contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#776> a skos:Concept ;
    skos:prefLabel "776" ;
    rdfs:comment "Contract clauses\n            Document specifying the clauses applying to a contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#775> a skos:Concept ;
    skos:prefLabel "775" ;
    rdfs:comment "Calling forward notice\n            Instructions for release or delivery of goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#774> a skos:Concept ;
    skos:prefLabel "774" ;
    rdfs:comment "General terms and conditions\n            Document specifying general terms and conditions." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#773> a skos:Concept ;
    skos:prefLabel "773" ;
    rdfs:comment "Coverage confirmation note\n            Document confirming that insurance coverage is granted." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#772> a skos:Concept ;
    skos:prefLabel "772" ;
    rdfs:comment "Binding customer agreement for contract\n            Document which is a binding agreement from the customer for a contract, such as an insurance contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#771> a skos:Concept ;
    skos:prefLabel "771" ;
    rdfs:comment "Binding offer\n            Document which is a binding offer from one party to another." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#770> a skos:Concept ;
    skos:prefLabel "770" ;
    rdfs:comment "Booking confirmation\n            Document/message issued by a carrier to confirm that space has been reserved for a consignment in means of transport." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#769> a skos:Concept ;
    skos:prefLabel "769" ;
    rdfs:comment "Advice report\n            Document reporting advice." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#768> a skos:Concept ;
    skos:prefLabel "768" ;
    rdfs:comment "Civil status document\n            Document which confirms the civil status of a person." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#767> a skos:Concept ;
    skos:prefLabel "767" ;
    rdfs:comment "Acknowledgment of receipt\n            Document/message confirming a receipt to the sending party." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#766> a skos:Concept ;
    skos:prefLabel "766" ;
    rdfs:comment "Combined transport bill of lading/multimodal bill of lading\n            Document which evidences a multimodal transport contract, the taking in charge of the goods by the multimodal transport operator, and an undertaking by him to deliver the goods in accordance with the terms of the contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#765> a skos:Concept ;
    skos:prefLabel "765" ;
    rdfs:comment "Multimodal transport document (generic)\n            Document/message which evidences a multimodal transport contract, the taking in charge of the goods by the multimodal transport operator, and an undertaking by him to deliver the goods in accordance with the terms of the contract. (International Convention on Multimodal Transport of Goods)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#764> a skos:Concept ;
    skos:prefLabel "764" ;
    rdfs:comment "Combined transport document (generic)\n            Negotiable or non-negotiable document evidencing a contract for the performance and/or procurement of performance of combined transport of goods and bearing on its face either the heading \"Negotiable combined transport document issued subject to Uniform Rules for a Combined Transport Document (ICC Brochure No. 298)\" or the heading \"Non-negotiable Combined Transport Document issued subject to Uniform Rules for a Combined Transport Document (ICC Brochure No. 298)\"." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#763> a skos:Concept ;
    skos:prefLabel "763" ;
    rdfs:comment "Forwarder's certificate of transport\n            Negotiable document/message issued by a forwarder to certify that he has taken charge of a specified consignment for despatch and delivery in accordance with the consignor's instructions, as indicated in the document, and that he accepts responsibility for delivery of the goods to the holder of the document through the intermediary of a delivery agent of his choice. E.g. FIATA-FCT." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#762> a skos:Concept ;
    skos:prefLabel "762" ;
    rdfs:comment "Tendering price/sales catalogue\n            A document/message providing information regarding pricing and catalogue details for goods and/or services to be offered as part of a tender." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#761> a skos:Concept ;
    skos:prefLabel "761" ;
    rdfs:comment "Through bill of lading\n            Bill of lading which evidences a contract of carriage from one place to another in separate stages of which at least one stage is a sea transit, and by which the issuing carrier accepts responsibility for the carriage as set forth in the through bill of lading." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#760> a skos:Concept ;
    skos:prefLabel "760" ;
    rdfs:comment "Multimodal/combined transport document (generic)\n            A transport document used when more than one mode of transportation is involved in the movement of cargo. It is a contract of carriage and receipt of the cargo for a multimodal transport. It indicates the place where the responsible transport company in the move takes responsibility for the cargo, the place where the responsibility of this transport company in the move ends and the conveyances involved." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#759> a skos:Concept ;
    skos:prefLabel "759" ;
    rdfs:comment "European Single Procurement Document\n            A document/message containing a self-declaration by the supplier, providing preliminary evidence during the tendering phase." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#758> a skos:Concept ;
    skos:prefLabel "758" ;
    rdfs:comment "Tender\n            A document/message used by a supplier to bid in a procurement procedure." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#757> a skos:Concept ;
    skos:prefLabel "757" ;
    rdfs:comment "Tendering price/sales catalogue request\n            A document/message requesting information regarding pricing and catalogue details for goods and/or services to be offered as part of a tender." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#756> a skos:Concept ;
    skos:prefLabel "756" ;
    rdfs:comment "European Single Procurement Document request\n            A document/message requesting a self-declaration from the supplier, providing preliminary evidence during the tendering phase." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#755> a skos:Concept ;
    skos:prefLabel "755" ;
    rdfs:comment "Invitation to tender\n            A document/message used by a buyer to define the procurement procedure and request specific suppliers to participate." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#754> a skos:Concept ;
    skos:prefLabel "754" ;
    rdfs:comment "Call for tender\n            A document/message used by a buyer to define the procurement procedure and request suppliers to participate." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#753> a skos:Concept ;
    skos:prefLabel "753" ;
    rdfs:comment "Certificate of sustainability\n            Document/message issued by a competent body certifying sustainability." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#752> a skos:Concept ;
    skos:prefLabel "752" ;
    rdfs:comment "Plant Passport\n            Document/message issued by a competent body certifying the phytosanitary status of plants or plant products for international trade." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#751> a skos:Concept ;
    skos:prefLabel "751" ;
    rdfs:comment "Invoice information for accounting purposes\n            A document / message containing accounting related information such as monetary summations, seller id and VAT information. This may not be a complete invoice according to legal requirements. For instance the line item information might be excluded." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#750> a skos:Concept ;
    skos:prefLabel "750" ;
    rdfs:comment "Despatch note (post parcels)\n            Document/message which, according to Article 106 of the \"Agreement concerning Postal Parcels\" under the UPU convention, is to accompany post parcels." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#749> a skos:Concept ;
    skos:prefLabel "749" ;
    rdfs:comment "Transport equipment gross mass verification message\n            Message containing information regarding gross mass verification of transport equipment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#748> a skos:Concept ;
    skos:prefLabel "748" ;
    rdfs:comment "Consignment despatch advice\n            Document/message by means of which the supplier informs the buyer about the despatch of goods ordered on consignment (goods to be delivered into stock with agreement on payment when goods are sold out of this stock)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#747> a skos:Concept ;
    skos:prefLabel "747" ;
    rdfs:comment "Payroll deductions advice\n            A message sent by a party (usually an employer or its representative) to a service providing organisation, to detail payroll deductions paid on behalf of its employees to the service providing organisation." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#746> a skos:Concept ;
    skos:prefLabel "746" ;
    rdfs:comment "Delivery notice (rail transport)\n            Document/message created by the consignor or by the departure station, joined to the transport or sent to the consignee, giving the possibility to the consignee or the arrival station to attest the delivery of the goods. The document must be returned to the consignor or to the departure station." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#745> a skos:Concept ;
    skos:prefLabel "745" ;
    rdfs:comment "Passenger list\n            Declaration to Customs regarding passengers aboard the conveyance; equivalent to IMO FAL 6." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#744> a skos:Concept ;
    skos:prefLabel "744" ;
    rdfs:comment "Crew's effects declaration\n            Declaration to Customs regarding the personal effects of crew members aboard the conveyance; equivalent to IMO FAL 4." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#743> a skos:Concept ;
    skos:prefLabel "743" ;
    rdfs:comment "Substitute air waybill\n            A temporary air waybill which contains only limited information because of the absence of the original." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#742> a skos:Concept ;
    skos:prefLabel "742" ;
    rdfs:comment "Metered services consumption report\n            Document/message providing metered consumption details." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#741> a skos:Concept ;
    skos:prefLabel "741" ;
    rdfs:comment "Master air waybill\n            Document/message made out by or on behalf of the agent/consolidator which evidences the contract between the agent/consolidator and carrier(s) for carriage of goods over routes of the carrier(s) for a consignment consisting of goods originated by more than one shipper (IATA)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#740> a skos:Concept ;
    skos:prefLabel "740" ;
    rdfs:comment "Air waybill\n            Document/message made out by or on behalf of the shipper which evidences the contract between the shipper and carrier(s) for carriage of goods over routes of the carrier(s) and which is identified by the airline prefix issuing the document plus a serial (IATA)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#739> a skos:Concept ;
    skos:prefLabel "739" ;
    rdfs:comment "Metered services consumption report supporting an invoice\n            Document/message providing metered consumption details supporiting an invoice." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#738> a skos:Concept ;
    skos:prefLabel "738" ;
    rdfs:comment "Cargo/goods handling and movement message\n            A message from a party to a warehouse, distribution centre, or logistics service provider identifying the handling services and where required the movement of specified goods, limited to warehouses within the jurisdiction of the distribution centre or log." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#737> a skos:Concept ;
    skos:prefLabel "737" ;
    rdfs:comment "Proof of delivery\n            A message by which a consignee provides for a carrier proof of delivery of a consignment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#736> a skos:Concept ;
    skos:prefLabel "736" ;
    rdfs:comment "Standing inquiry on complete product information\n            A product inquiry which stands until it is cancelled. It requests not only the updates since last time, but always the complete product information of a data supplier. This means that within the standing request every time a complete download of the respe." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#735> a skos:Concept ;
    skos:prefLabel "735" ;
    rdfs:comment "Sales data report\n            A message enabling companies to exchange or report electronically, basic sales data related to products or services, including the corresponding location, time period, product identification, pricing and quantity information. It enables the recipient to p." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#734> a skos:Concept ;
    skos:prefLabel "734" ;
    rdfs:comment "Sales forecast report\n            A message enabling companies to exchange or report electronically, basic sales forecast data related to products or services, including the corresponding location, time period, product identification, pricing and quantity information. It enables the recip." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#733> a skos:Concept ;
    skos:prefLabel "733" ;
    rdfs:comment "Instruction for returns\n            A message by which a party informs another party whether and how goods shall be returned." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#732> a skos:Concept ;
    skos:prefLabel "732" ;
    rdfs:comment "Announcement for returns\n            A message by which a party announces to another party details of goods for return due to specified reasons (e.g. returns for repair, returns because of damage, etc)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#731> a skos:Concept ;
    skos:prefLabel "731" ;
    rdfs:comment "Commercial account summary\n            A message enabling the transmission of commercial data concerning payments made and outstanding items on an account over a period of time." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#730> a skos:Concept ;
    skos:prefLabel "730" ;
    rdfs:comment "Road consignment note\n            Transport document/message which evidences a contract between a carrier and a sender for the carriage of goods by road (generic term). Remark: For international road traffic, this document must contain at least the particulars prescribed by the convention on the contract for the international carriage of goods by road (CMR)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#729> a skos:Concept ;
    skos:prefLabel "729" ;
    rdfs:comment "Returns advice\n            Document/message by means of which the buyer informs the seller about the despatch of returned goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#728> a skos:Concept ;
    skos:prefLabel "728" ;
    rdfs:comment "Price/sales catalogue containing commercial information\n            A price/sales catalogue message containing only commercial terms or conditions data." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#727> a skos:Concept ;
    skos:prefLabel "727" ;
    rdfs:comment "Price/sales catalogue not containing commercial information\n            A price/sales catalogue message containing no commercial information, such as prices, terms or conditions." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#726> a skos:Concept ;
    skos:prefLabel "726" ;
    rdfs:comment "Manufacturer raised consignment order\n            Document/message providing details of a consignment order which has been raised by a manufacturer." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#725> a skos:Concept ;
    skos:prefLabel "725" ;
    rdfs:comment "Manufacturer raised order\n            Document/message providing details of an order which has been raised by a manufacturer." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#724> a skos:Concept ;
    skos:prefLabel "724" ;
    rdfs:comment "Recharging document\n            Fictitious transport document regarding a previous transport, enabling a carrier's agent to give to another carrier's agent (in a different country) the possibility to collect charges relating to the original transport (rail environment)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#723> a skos:Concept ;
    skos:prefLabel "723" ;
    rdfs:comment "Escort official recognition\n            Document/message which gives right to the owner to exert all functions normally transferred to a guard in a train by which an escorted consignment is transported." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#722> a skos:Concept ;
    skos:prefLabel "722" ;
    rdfs:comment "Road list-SMGS\n            Accounting document, one copy of which is drawn up for each consignment note; it accompanies the consignment over the whole route and is a rail transport document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#721> a skos:Concept ;
    skos:prefLabel "721" ;
    rdfs:comment "Product data response\n            Document/message responding to a previously received Product Data document/message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#720> a skos:Concept ;
    skos:prefLabel "720" ;
    rdfs:comment "Rail consignment note (generic term)\n            Transport document constituting a contract for the carriage of goods between the sender and the carrier (the railway). For international rail traffic, this document must conform to the model prescribed by the international conventions concerning carriage of goods by rail, e.g. CIM Convention, SMGS Convention." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#719> a skos:Concept ;
    skos:prefLabel "719" ;
    rdfs:comment "General message\n            Document/message providing agreed textual information." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#718> a skos:Concept ;
    skos:prefLabel "718" ;
    rdfs:comment "Seamanï¿½s book\n            A national identity document issued to professional seamen that contains a record of their rank and service career." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#717> a skos:Concept ;
    skos:prefLabel "717" ;
    rdfs:comment "Residence permit\n            A document authorizing residence." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#716> a skos:Concept ;
    skos:prefLabel "716" ;
    rdfs:comment "Forwarder's bill of lading\n            Non-negotiable document issued by a freight forwarder evidencing a contract for the carriage of goods by sea and the taking over or loading of the goods by the freight forwarder, and by which the freight forwarder undertakes to deliver the goods to the consignee named in the document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#715> a skos:Concept ;
    skos:prefLabel "715" ;
    rdfs:comment "Letter of indemnity for non-surrender of bill of lading\n            Document/message issued by a commercial party or a bank of an insurance company accepting responsibility to the beneficiary of the indemnity in accordance with the terms thereof." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#714> a skos:Concept ;
    skos:prefLabel "714" ;
    rdfs:comment "House bill of lading\n            The bill of lading issued not by the carrier but by the freight forwarder/consolidator known by the carrier." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#713> a skos:Concept ;
    skos:prefLabel "713" ;
    rdfs:comment "Mate's receipt\n            Document/message issued by a ship's officer to acknowledge that a specified consignment has been received on board a vessel, and the apparent condition of the goods; enabling the carrier to issue a Bill of lading." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#712> a skos:Concept ;
    skos:prefLabel "712" ;
    rdfs:comment "Non-negotiable maritime transport document (generic)\n            Non-negotiable document which evidences a contract for the carriage of goods by sea and the taking over or loading of the goods by the carrier, and by which the carrier undertakes to deliver the goods to the consignee named in the document. E.g. Sea waybill. Remark: Synonymous with \"straight\" or \"non-negotiable Bill of lading\" used in certain countries, e.g. Canada." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#711> a skos:Concept ;
    skos:prefLabel "711" ;
    rdfs:comment "Inland waterway bill of lading\n            Negotiable transport document made out to a named person, to order or to bearer, signed by the carrier and handed to the sender after receipt of the goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#710> a skos:Concept ;
    skos:prefLabel "710" ;
    rdfs:comment "Sea waybill\n            Non-negotiable document which evidences a contract for the carriage of goods by sea and the taking over of the goods by the carrier, and by which the carrier undertakes to deliver the goods to the consignee named in the document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#709> a skos:Concept ;
    skos:prefLabel "709" ;
    rdfs:comment "Tanker bill of lading\n            Document which evidences a transport of liquid bulk cargo." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#708> a skos:Concept ;
    skos:prefLabel "708" ;
    rdfs:comment "Empty container bill\n            Bill of lading indicating an empty container." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#707> a skos:Concept ;
    skos:prefLabel "707" ;
    rdfs:comment "Bill of lading copy\n            A copy of the bill of lading issued by a transport company." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#706> a skos:Concept ;
    skos:prefLabel "706" ;
    rdfs:comment "Bill of lading original\n            The original of the bill of lading issued by a transport company. When issued by the maritime industry it could signify ownership of the cargo." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#705> a skos:Concept ;
    skos:prefLabel "705" ;
    rdfs:comment "Bill of lading\n            Negotiable document/message which evidences a contract of carriage by sea and the taking over or loading of goods by carrier, and by which carrier undertakes to deliver goods against surrender of the document. A provision in the document that goods are to be delivered to the order of a named person, or to order, or to bearer, constitutes such an undertaking." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#704> a skos:Concept ;
    skos:prefLabel "704" ;
    rdfs:comment "Master bill of lading\n            A bill of lading issued by the master of a vessel (in actuality the owner or charterer of the vessel). It could cover a number of house bills." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#703> a skos:Concept ;
    skos:prefLabel "703" ;
    rdfs:comment "House waybill\n            The document made out by an agent/consolidator which evidences the contract between the shipper and the agent/consolidator for the arrangement of carriage of goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#702> a skos:Concept ;
    skos:prefLabel "702" ;
    rdfs:comment "Goods receipt, carriage\n            Document/message issued by a carrier or a carrier's agent, acknowledging receipt for carriage of goods specified therein on conditions stated or referred to in the document, enabling the carrier to issue a transport document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#701> a skos:Concept ;
    skos:prefLabel "701" ;
    rdfs:comment "Universal (multipurpose) transport document\n            Document/message evidencing a contract of carriage covering the movement of goods by any mode of transport, or combination of modes, for national as well as international transport, under any applicable international convention or national law and under the conditions of carriage of any carrier or transport operator undertaking or arranging the transport referred to in the document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#700> a skos:Concept ;
    skos:prefLabel "700" ;
    rdfs:comment "Waybill\n            Non-negotiable document evidencing the contract for the transport of cargo." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#661> a skos:Concept ;
    skos:prefLabel "661" ;
    rdfs:comment "Declaration of Conformity\n            A self-issued document in which the manufacturer or supplier declares that their product, process, or service meets the specified standards or regulatory requirements." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#660> a skos:Concept ;
    skos:prefLabel "660" ;
    rdfs:comment "Production Report\n            A document that provides production information such as the identification and number of units of materials used and produced commonly related to manufacturing instructions, purchase orders and other documents." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#659> a skos:Concept ;
    skos:prefLabel "659" ;
    rdfs:comment "Bayplan/stowage plan, partial\n            A partial bayplan. containing only a selected part of the available stowage locations." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#658> a skos:Concept ;
    skos:prefLabel "658" ;
    rdfs:comment "Bayplan/stowage plan, full\n            A full bayplan containing all occupied and/or blocked stowage locations." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#657> a skos:Concept ;
    skos:prefLabel "657" ;
    rdfs:comment "Phytosanitary Re-export Certificate\n            A message/document consistent with the model for re-export phytosanitary certificates of the IPPC, attesting that a consignment meets phytosanitary import requirements." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#656> a skos:Concept ;
    skos:prefLabel "656" ;
    rdfs:comment "Resale information\n            Document/message providing information on a resale." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#655> a skos:Concept ;
    skos:prefLabel "655" ;
    rdfs:comment "Gate pass\n            Document/message authorizing goods specified therein to be brought out of a fenced-in port or terminal area." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#654> a skos:Concept ;
    skos:prefLabel "654" ;
    rdfs:comment "Declaration for radioactive material\n            A declaration to be presented to the competent authority when radioactive material moves cross-border." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#653> a skos:Concept ;
    skos:prefLabel "653" ;
    rdfs:comment "Previous correspondence\n            Correspondence previously exchanged." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#652> a skos:Concept ;
    skos:prefLabel "652" ;
    rdfs:comment "Low risk country formal letter\n            An official letter issued by an import authority granted to the importer of goods from a low risk country which allows the importer to place its products in the local market with certain favorable considerations." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#651> a skos:Concept ;
    skos:prefLabel "651" ;
    rdfs:comment "Manufacturing license\n            A license granted by a competent authority to a manufacturer for production of specific products." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#650> a skos:Concept ;
    skos:prefLabel "650" ;
    rdfs:comment "Handling order\n            Document/message issued by a cargo handling organization (port administration, terminal operator, etc.) for the removal or other handling of goods under their care." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#649> a skos:Concept ;
    skos:prefLabel "649" ;
    rdfs:comment "Production facility license\n            A license granted by a competent authority to a production facility for manufacturing specific products." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#648> a skos:Concept ;
    skos:prefLabel "648" ;
    rdfs:comment "Certificate of compliance with standards of the World Organization for Animal Health (OIE)\n            A certification that the products have been treated in a way consistent with the standards set by the World Organization for Animal Health (OIE)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#647> a skos:Concept ;
    skos:prefLabel "647" ;
    rdfs:comment "Drug shelf life study report\n            A document containing results from the study which determines the shelf life, namely the time period of storage at a specified condition within which a drug substance or drug product still meets its established specifications; its identity, strength, quality and purity." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#646> a skos:Concept ;
    skos:prefLabel "646" ;
    rdfs:comment "Public price certificate\n            A certification executed by the competent authority from country of production stating the price of the goods to the general public." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#645> a skos:Concept ;
    skos:prefLabel "645" ;
    rdfs:comment "Export price certificate\n            A certification executed by the competent authority from country of exportation stating the export price of the goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#644> a skos:Concept ;
    skos:prefLabel "644" ;
    rdfs:comment "Packaging material composition report\n            A document that shows the main structure that composes the packaging material." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#643> a skos:Concept ;
    skos:prefLabel "643" ;
    rdfs:comment "Food packaging contact certificate\n            A document legalized from a competent authority that shows that the food packaging product is safe to come into contact with food." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#642> a skos:Concept ;
    skos:prefLabel "642" ;
    rdfs:comment "Certificate of food item transport readiness\n            A certificate to verify readiness of a transport or transport area such as a reservoir or hold to transport food items." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#641> a skos:Concept ;
    skos:prefLabel "641" ;
    rdfs:comment "Thermographic reading report\n            A report of temperature readings over a period." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#640> a skos:Concept ;
    skos:prefLabel "640" ;
    rdfs:comment "Delivery order\n            Document/message issued by a party entitled to authorize the release of goods specified therein to a named consignee, to be retained by the custodian of the goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#639> a skos:Concept ;
    skos:prefLabel "639" ;
    rdfs:comment "Certificate of refrigerated transport equipment inspection\n            Inspection document shows that the container, the cooling devices and measured temperature is in good working condition." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#638> a skos:Concept ;
    skos:prefLabel "638" ;
    rdfs:comment "Certificate of suitability for transport of grains and legumes\n            Certificate of inspection for the vessel stating its readiness and suitability for transporting grains and legumes." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#637> a skos:Concept ;
    skos:prefLabel "637" ;
    rdfs:comment "Food grade certificate\n            A document that shows that the product (food additive, detergent, disinfectant and sanitizer) is suitable to be used in the food industry." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#636> a skos:Concept ;
    skos:prefLabel "636" ;
    rdfs:comment "Health certificate\n            A document legalized from a competent authority that shows that the product has been tested microbiologically and is free from any pathogens and fit for human consumption and/or declares that the product is in compliance with sanitary and phytosanitary measures." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#635> a skos:Concept ;
    skos:prefLabel "635" ;
    rdfs:comment "Warehouse warrant\n            Negotiable receipt document, issued by a Warehouse Keeper to a person placing goods in a warehouse and conferring title to the goods stored." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#634> a skos:Concept ;
    skos:prefLabel "634" ;
    rdfs:comment "Certified list of ingredients\n            A document legalized from a competent authority that shows the components of the product (food additive, detergent, disinfectant and sanitizer)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#633> a skos:Concept ;
    skos:prefLabel "633" ;
    rdfs:comment "Port charges documents\n            Documents/messages specifying services rendered, storage and handling costs, demurrage and other charges due to the owner of goods described therein." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#632> a skos:Concept ;
    skos:prefLabel "632" ;
    rdfs:comment "Goods receipt\n            Document/message to acknowledge the receipt of goods and in addition may indicate receiving conditions." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#631> a skos:Concept ;
    skos:prefLabel "631" ;
    rdfs:comment "Forwarder's warehouse receipt\n            Document/message issued by a forwarder acting as Warehouse Keeper acknowledging receipt of goods placed in a warehouse, and stating or referring to the conditions which govern the warehousing and the release of goods. The document contains detailed provisions regarding the rights of holders-by-endorsement, transfer of ownership, etc. E.g. FIATA-FWR." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#630> a skos:Concept ;
    skos:prefLabel "630" ;
    rdfs:comment "Shipping note\n            (1123) Document/message provided by the shipper or his agent to the carrier, multimodal transport operator, terminal or other receiving authority, giving information about export consignments offered for transport, and providing for the necessary receipts and declarations of liability. Sometimes a multipurpose cargo handling document also fulfilling the functions of document 632, 633, 650 and 655." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#629> a skos:Concept ;
    skos:prefLabel "629" ;
    rdfs:comment "Veterinary quarantine certificate\n            A certification that livestock or animal products, that are either imported or entering free zones, are kept under health supervision for a time period determined by veterinary quarantine instructions." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#628> a skos:Concept ;
    skos:prefLabel "628" ;
    rdfs:comment "Transit license\n            Document/message issued by the competent body in accordance with transit regulations in force, by which authorization is granted to a party to move articles under customs procedure." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#627> a skos:Concept ;
    skos:prefLabel "627" ;
    rdfs:comment "Free Sale Certificate in the Country of Origin\n            A certificate confirming that a specified product is free for sale in the country of origin." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#626> a skos:Concept ;
    skos:prefLabel "626" ;
    rdfs:comment "Convention on International Trade in Endangered Species of Wild Fauna and Flora (CITES) Certificate\n            A certificate used in the trade of endangered species in accordance with the CITES convention." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#625> a skos:Concept ;
    skos:prefLabel "625" ;
    rdfs:comment "Heat Treatment Certificate\n            A certificate verifying the heat treatment of the product is in conformance with international standards to ensure the productï¿½s healthiness and/or shows the mode of heat treatment indicating the temperature and the amount of time the product or raw material used in the product was treated (such as milk)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#624> a skos:Concept ;
    skos:prefLabel "624" ;
    rdfs:comment "Forwarder's certificate of receipt\n            Non-negotiable document issued by a forwarder to certify that he has assumed control of a specified consignment, with irrevocable instructions to send it to the consignee indicated in the document or to hold it at his disposal. E.g. FIATA-FCR." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#623> a skos:Concept ;
    skos:prefLabel "623" ;
    rdfs:comment "Forwarder's invoice\n            Invoice issued by a freight forwarder specifying services rendered and costs incurred and claiming payment therefore." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#622> a skos:Concept ;
    skos:prefLabel "622" ;
    rdfs:comment "Forwarder's advice to exporter\n            Document/message issued by a freight forwarder informing an exporter of the action taken in fulfillment of instructions received." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#621> a skos:Concept ;
    skos:prefLabel "621" ;
    rdfs:comment "Forwarder's advice to import agent\n            Document/message issued by a freight forwarder in an exporting country advising his counterpart in an importing country about the forwarding of goods described therein." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#610> a skos:Concept ;
    skos:prefLabel "610" ;
    rdfs:comment "Forwarding instructions\n            Document/message issued to a freight forwarder, giving instructions regarding the action to be taken by the forwarder for the forwarding of goods described therein." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#589> a skos:Concept ;
    skos:prefLabel "589" ;
    rdfs:comment "Halal Slaughtering Certificate\n            A certificate verifying that meat has been produced from slaughter in accordance with Islamic laws and practices." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#588> a skos:Concept ;
    skos:prefLabel "588" ;
    rdfs:comment "Transport Means Security Report\n            A document reporting the security status and related information of a means of transport." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#587> a skos:Concept ;
    skos:prefLabel "587" ;
    rdfs:comment "Customs declaration for TIR Carnet goods\n            A Customs declaration in which goods move under cover of TIR Carnets." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#586> a skos:Concept ;
    skos:prefLabel "586" ;
    rdfs:comment "Document for establishing the Customs Status of goods for San Marino (T2LSM)\n            Form establishing the Community status of goods (\"T2L\" under European Legislation) in the context of trade between the EU and San Marino. (\"T2LSM\" under EU Legislation)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#585> a skos:Concept ;
    skos:prefLabel "585" ;
    rdfs:comment "EU Document for establishing the Community status of goods for certain fiscal purposes (T2LF)\n            Form establishing the Community status of goods in the context of trade between the \"VAT\" territory of EU Member States and EU territories where the VAT rules do not apply, such as Canary islands, some French overseas territories, the Channel islands and the Aaland islands, and between those territories (\"T2LF\" under EU Legislation)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#584> a skos:Concept ;
    skos:prefLabel "584" ;
    rdfs:comment "EU Document for establishing the Community status of goods (T2L)\n            Form establishing the Community status of goods (\"T2L\" under EU Legislation)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#583> a skos:Concept ;
    skos:prefLabel "583" ;
    rdfs:comment "EU Customs declaration for mixed consignments (T)\n            Customs declaration for goods under the Community/common transit procedure for mixed consignments (i.e. consignments that comprise goods of different statuses, like \"T1\" and \"T2\") (\"T\" under EU Legislation)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#582> a skos:Concept ;
    skos:prefLabel "582" ;
    rdfs:comment "EU Customs declaration for internal transit to San Marino (T2SM)\n            Customs declaration for goods under the internal Community transit procedure between the Community and San Marino. (\"T2SM\" under EU Legislation)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#581> a skos:Concept ;
    skos:prefLabel "581" ;
    rdfs:comment "EU Customs declaration for non-fiscal area internal Community Transit (T2F)\n            Declaration for goods under the internal Community transit procedure in the context of trade between the \"VAT\" territory of EU Member States and EU territories where the VAT rules do not apply, such as Canary islands, some French overseas territories, the Channel islands and the Aaland islands, and between those territories. (\"T2F\" under EU Legislation)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#580> a skos:Concept ;
    skos:prefLabel "580" ;
    rdfs:comment "Cover note\n            Document/message issued by an insurer (insurance broker, agent, etc.) to notify the insured that his insurance have been carried out." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#579> a skos:Concept ;
    skos:prefLabel "579" ;
    rdfs:comment "EU Customs declaration for internal Community Transit (T2)\n            Customs declaration for goods under the internal Community/common transit procedure. This applies to \"Community goods\" (\"T2\" under EU legislation and EC-EFTA \"Transit Convention\")." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#578> a skos:Concept ;
    skos:prefLabel "578" ;
    rdfs:comment "EU Customs declaration for External Community Transit (T1)\n            Customs declaration for goods under the external Community/common transit procedure. This applies to \"non-Community goods\" (\"T1\" under EU legislation and EC-EFTA \"Transit Convention\")." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#577> a skos:Concept ;
    skos:prefLabel "577" ;
    rdfs:comment "Transport capacity request\n            Request for capacity for the transport of goods for a date and a route." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#576> a skos:Concept ;
    skos:prefLabel "576" ;
    rdfs:comment "Storage capacity request\n            Request for capacity to store goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#575> a skos:Concept ;
    skos:prefLabel "575" ;
    rdfs:comment "Insurer's invoice\n            Document/message issued by an insurer specifying the cost of an insurance which has been effected and claiming payment therefore." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#554> a skos:Concept ;
    skos:prefLabel "554" ;
    rdfs:comment "Storage capacity offer\n            Offering of capacity to store goods." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#553> a skos:Concept ;
    skos:prefLabel "553" ;
    rdfs:comment "Forwarderï¿½s invoice discrepancy report\n            Document/message reporting invoice discrepancies indentified by the forwarder." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#552> a skos:Concept ;
    skos:prefLabel "552" ;
    rdfs:comment "Ship Security Plan\n            Ship Security Plan (SSP) is a document prepared in terms of the ISPS Code to contribute to the prevention of illegal acts against the ship and its crew." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#551> a skos:Concept ;
    skos:prefLabel "551" ;
    rdfs:comment "Transport capacity offer\n            Offering of capacity for the transport of goods for a date and a route." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#550> a skos:Concept ;
    skos:prefLabel "550" ;
    rdfs:comment "Insurance declaration sheet (bordereau)\n            A document/message used when an insured reports to his insurer details of individual shipments which are covered by an insurance contract - an open cover or a floating policy - between the parties." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#539> a skos:Concept ;
    skos:prefLabel "539" ;
    rdfs:comment "Framework Agreement\n            An agreement between one or more contracting authorities and one or more economic operators, the purpose of which is to establish the terms governing contracts to be awarded during a given period, in particular with regard to price and, where appropriate, the quantity envisaged." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#538> a skos:Concept ;
    skos:prefLabel "538" ;
    rdfs:comment "Good Manufacturing Practice (GMP) Certificate\n            Certificate that guarantees quality manufacturing and processing of food products, medications, cosmetics, etc." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#537> a skos:Concept ;
    skos:prefLabel "537" ;
    rdfs:comment "Interim International Ship Security Certificate\n            An interim certificate on ship security issued basis under the International code for the Security of Ships and of Port facilities (ISPS code)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#536> a skos:Concept ;
    skos:prefLabel "536" ;
    rdfs:comment "International Ship Security Certificate\n            A certificate on ship security issued based on the International code for the Security of Ships and of Port facilities (ISPS code)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#535> a skos:Concept ;
    skos:prefLabel "535" ;
    rdfs:comment "Pro-forma accounting voucher\n            To indicate that the document/message justifying an accounting entry is pro-forma." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#534> a skos:Concept ;
    skos:prefLabel "534" ;
    rdfs:comment "Copy accounting voucher\n            To indicate that the document/message justifying an accounting entry is a copy." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#533> a skos:Concept ;
    skos:prefLabel "533" ;
    rdfs:comment "Original accounting voucher\n            To indicate that the document/message justifying an accounting entry is original." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#532> a skos:Concept ;
    skos:prefLabel "532" ;
    rdfs:comment "Forwarderï¿½s credit note\n            Document/message for providing credit information to the relevant party." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#531> a skos:Concept ;
    skos:prefLabel "531" ;
    rdfs:comment "Refugee Permit\n            Document identifying a refugee recognized by a country." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#530> a skos:Concept ;
    skos:prefLabel "530" ;
    rdfs:comment "Insurance policy\n            Document/message issued by the insurer evidencing an agreement to insure and containing the conditions of the agreement concluded whereby the insurer undertakes for a specific fee to indemnify the insured for the losses arising out of the perils and accidents specified in the contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#529> a skos:Concept ;
    skos:prefLabel "529" ;
    rdfs:comment "Re-Entry Permit\n            A permit to re-enter a country." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#528> a skos:Concept ;
    skos:prefLabel "528" ;
    rdfs:comment "Military Identification Card\n            The official document used for military personnel on travel orders, substituting a passport." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#527> a skos:Concept ;
    skos:prefLabel "527" ;
    rdfs:comment "Self billed debit note\n            A document which indicates that the customer is claiming debit in a self billing environment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#526> a skos:Concept ;
    skos:prefLabel "526" ;
    rdfs:comment "Accounting voucher\n            A document/message justifying an accounting entry." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#525> a skos:Concept ;
    skos:prefLabel "525" ;
    rdfs:comment "WCO Conveyance Departure Report\n            Declaration, in accordance with the WCO Customs Data Model, to Customs regarding the conveyance departing a Customs territory." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#524> a skos:Concept ;
    skos:prefLabel "524" ;
    rdfs:comment "WCO Conveyance Arrival Report\n            Declaration, in accordance with the WCO Customs Data Model, to Customs regarding the conveyance arriving in a Customs territory." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#523> a skos:Concept ;
    skos:prefLabel "523" ;
    rdfs:comment "Dangerous Goods Notification for non-tanker vessel\n            Dangerous Goods Notification for a vessel carrying cargo other than bulk liquid cargo." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#522> a skos:Concept ;
    skos:prefLabel "522" ;
    rdfs:comment "Dangerous Goods Notification for Tanker vessel\n            Dangerous Goods Notification for a vessel carrying liquid cargo in bulk." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#521> a skos:Concept ;
    skos:prefLabel "521" ;
    rdfs:comment "Special requirements permit related to the transport of cargo\n            A permit related to a transport document granting the transport of cargo under the conditions as specifically required." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#520> a skos:Concept ;
    skos:prefLabel "520" ;
    rdfs:comment "Insurance certificate\n            Document/message issued to the insured certifying that insurance has been effected and that a policy has been issued. Such a certificate for a particular cargo is primarily used when good are insured under the terms of a floating or an open policy; at the request of the insured it can be exchanged for a policy." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#507> a skos:Concept ;
    skos:prefLabel "507" ;
    rdfs:comment "Emission Inventory Report\n            A document detailing the types and quantities of pollutants, greenhouse gases (GHGs), and other harmful emissions released into the environment as a result of an organization's activities." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#506> a skos:Concept ;
    skos:prefLabel "506" ;
    rdfs:comment "Resource Consumption Report\n            A document detailing the organization's energy use, including electricity, heating, and cooling, across different facilities and operations or water consumption." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#505> a skos:Concept ;
    skos:prefLabel "505" ;
    rdfs:comment "Corporate Sustainability Due Diligence Report\n            A document detailing the actions taken by a company to identify and act on actual and potential risks to people and to the environment. Not only within its own operations but throughout its entire supply chain." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#504> a skos:Concept ;
    skos:prefLabel "504" ;
    rdfs:comment "Consumer Product Circularity Performance Report\n            A document detailing how effectively a product follows circular economy principles throughout its lifecycle, from design and production to use and end-of-life management." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#503> a skos:Concept ;
    skos:prefLabel "503" ;
    rdfs:comment "Prepayment credit note\n            A document/message providing credit information to the relevant party which indicates that the buyer has to pay amounts for goods and services in advance; these amounts will be subtracted from the prepayment invoice." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#502> a skos:Concept ;
    skos:prefLabel "502" ;
    rdfs:comment "Self billed factored credit note\n            An invoice assigned to a third party for collection, produced by the buyer (invoicee) which indicates that the buyer is claiming credit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#501> a skos:Concept ;
    skos:prefLabel "501" ;
    rdfs:comment "Self billed factored invoice\n            An invoice assigned to a third party for collection, produced by the buyer (invoicee) instead of the seller." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#500> a skos:Concept ;
    skos:prefLabel "500" ;
    rdfs:comment "Self billed prepayment invoice\n            An invoice produced by the buyer (invoicee) instead of the seller, which indicates that the buyer has to pay amounts for goods and services in advance; these amounts will be subtracted from the final invoice." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#499> a skos:Concept ;
    skos:prefLabel "499" ;
    rdfs:comment "Previous transport document\n            Identification of the previous transport document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#498> a skos:Concept ;
    skos:prefLabel "498" ;
    rdfs:comment "WCO second step of two-step import declaration\n            Second part of a simplified declaration, in accordance with the WCO Customs Data Model, to Customs by which goods are declared for Customs import procedure based on the 1999 Kyoto Convention." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#497> a skos:Concept ;
    skos:prefLabel "497" ;
    rdfs:comment "WCO first step of two-step import declaration\n            First part of a simplified declaration, in accordance with the WCO Customs Data Model, to Customs by which goods are declared for Customs import procedure based on the 1999 Kyoto Convention." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#496> a skos:Concept ;
    skos:prefLabel "496" ;
    rdfs:comment "WCO one-step import declaration\n            Single step declaration, in accordance with the WCO Customs Data Model, to Customs by which goods are declared for Customs import procedure based on the 1999 Kyoto Convention." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#495> a skos:Concept ;
    skos:prefLabel "495" ;
    rdfs:comment "WCO second step of two-step export declaration\n            Second part of a simplified declaration, in accordance with the WCO Customs Data Model, to Customs by which goods are declared for Customs export procedure based on the 1999 Kyoto Convention." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#494> a skos:Concept ;
    skos:prefLabel "494" ;
    rdfs:comment "Direct delivery (transport)\n            Document/message ordering the direct delivery of goods/consignment from one means of transport into another means of transport in one movement." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#493> a skos:Concept ;
    skos:prefLabel "493" ;
    rdfs:comment "Statement of account message\n            Usage of STATAC-message." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#491> a skos:Concept ;
    skos:prefLabel "491" ;
    rdfs:comment "Promissory note\n            Document/message, issued and signed in conformity with the applicable legislation, which contains an unconditional promise whereby the maker undertakes to pay a definite sum of money to the payee or to his order, on demand or at a definite time, against the surrender of the document itself." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#490> a skos:Concept ;
    skos:prefLabel "490" ;
    rdfs:comment "Bill of exchange\n            Document/message, issued and signed in conformity with the applicable legislation, which contains an unconditional order whereby the drawer directs the drawee to pay a definite sum of money to the payee or to his order, on demand or at a definite time, against the surrender of the document itself." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#489> a skos:Concept ;
    skos:prefLabel "489" ;
    rdfs:comment "Reefer connection order\n            Order to connect a reefer container to a reefer point." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#488> a skos:Concept ;
    skos:prefLabel "488" ;
    rdfs:comment "Deratting exemption certificate\n            Document certifying that the object was free of rats when inspected and that it is exempt from a deratting statement." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#487> a skos:Concept ;
    skos:prefLabel "487" ;
    rdfs:comment "Certificate of disembarkation permission\n            Document or message issuing permission to disembark." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#486> a skos:Concept ;
    skos:prefLabel "486" ;
    rdfs:comment "Multiple direct debit\n            Document/message containing a direct debit to credit one or more accounts and to debit one or more debtors." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#485> a skos:Concept ;
    skos:prefLabel "485" ;
    rdfs:comment "Banker's draft\n            Draft drawn in favour of a third party either by one bank on another bank, or by a branch of a bank on its head office (or vice versa) or upon another branch of the same bank. In either case, the draft should comply with the specifications laid down for cheques in the country in which it is to be payable." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#484> a skos:Concept ;
    skos:prefLabel "484" ;
    rdfs:comment "Multiple direct debit request\n            Document/message containing a direct debit request to credit one or more accounts and to debit one or more debtors." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#483> a skos:Concept ;
    skos:prefLabel "483" ;
    rdfs:comment "Visa\n            An endorsement on a passport or any other recognised travel document indicating that it has been examined and found correct, especially as permitting the holder to enter or leave a country." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#482> a skos:Concept ;
    skos:prefLabel "482" ;
    rdfs:comment "Port authority waste disposal report\n            Document/message sent by a port authority to another port authority for reporting information on waste disposal." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#481> a skos:Concept ;
    skos:prefLabel "481" ;
    rdfs:comment "Remittance advice\n            Document/message advising of the remittance of payment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#480> a skos:Concept ;
    skos:prefLabel "480" ;
    rdfs:comment "Invoice out of scope of tax\n            An invoice issued by a party who is out of the scope of tax regulations and shall not collect tax on the invoice. The invoice should not contain tax details or information about the party tax registrations." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#479> a skos:Concept ;
    skos:prefLabel "479" ;
    rdfs:comment "Environmental, Social, and Governance (ESG) Report\n            A document commonly addressed to investors and regulators, containing standardized data to assess corporate performance and risk, detailing a company's impact and efforts regarding environmental and social issues, as well as corporate board and management." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#478> a skos:Concept ;
    skos:prefLabel "478" ;
    rdfs:comment "Chemical Safety Assessment (CSA)\n            A document that details the process and findings of a Chemical Safety Assessment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#477> a skos:Concept ;
    skos:prefLabel "477" ;
    rdfs:comment "Recycling Instructions\n            A document or guideline detailing how products can be recycled correctly and efficiently (such as sorting instructions, disassembly procedures, hazardous material handling, recycling techniques)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#476> a skos:Concept ;
    skos:prefLabel "476" ;
    rdfs:comment "Disposal Instructions\n            A document detailing how to safely dispose of products, especially those that may contain hazardous materials." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#475> a skos:Concept ;
    skos:prefLabel "475" ;
    rdfs:comment "Sustainability Report\n            A document commonly addressed to customers, employees, and the general public, detailing a company's initiatives, goals, performance, and impacts across environmental, social, and economic dimensions." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#474> a skos:Concept ;
    skos:prefLabel "474" ;
    rdfs:comment "Product Circularity Data\n            A document/message providing data relating to how well the product adheres to circular principles, such as durability, recyclability, or ease of repair." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#473> a skos:Concept ;
    skos:prefLabel "473" ;
    rdfs:comment "Self-billed factored corrective invoice\n            Invoice produced by the invoicee instead of the seller, assigned to a third party for collection, that includes revised information differing from an earlier submission of the same invoice." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#472> a skos:Concept ;
    skos:prefLabel "472" ;
    rdfs:comment "Factored corrective Invoice\n            Invoice assigned to a third party for collection that includes revised information differing from an earlier submission of the same invoice." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#471> a skos:Concept ;
    skos:prefLabel "471" ;
    rdfs:comment "Self-billed corrective invoice\n            Invoice produced by the invoicee is producing instead of the seller that includes revised information differing from an earlier submission of the same invoice." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#470> a skos:Concept ;
    skos:prefLabel "470" ;
    rdfs:comment "Waste disposal report\n            Document/message sent by a shipping agent to an authority for reporting information on waste disposal." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#469> a skos:Concept ;
    skos:prefLabel "469" ;
    rdfs:comment "Documentary credit amendment\n            Document/message whereby a bank notifies a beneficiary of the details of an amendment to the terms and conditions of a documentary credit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#468> a skos:Concept ;
    skos:prefLabel "468" ;
    rdfs:comment "Documentary credit amendment notification\n            Document/message whereby a bank advises that the terms and conditions of a documentary credit have been amended." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#467> a skos:Concept ;
    skos:prefLabel "467" ;
    rdfs:comment "Documentary credit transfer advice\n            Document/message whereby a bank advises that (part of) a documentary credit is being or has been transferred in favour of a second beneficiary." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#466> a skos:Concept ;
    skos:prefLabel "466" ;
    rdfs:comment "Documentary credit notification\n            Document/message issued by an advising bank in order to transmit a documentary credit to a beneficiary, or to another advising bank." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#465> a skos:Concept ;
    skos:prefLabel "465" ;
    rdfs:comment "Documentary credit\n            Document/message in which a bank states that it has issued a documentary credit under which the beneficiary is to obtain payment, acceptance or negotiation on compliance with certain terms and conditions and against presentation of stipulated documents and such drafts as may be specified. The credit may or may not be confirmed by another bank." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#464> a skos:Concept ;
    skos:prefLabel "464" ;
    rdfs:comment "Intermediate handling cross docking despatch advice\n            Document by means of which the supplier or consignor informs the buyer, consignee or the distribution centre about the despatch of products which will be moved across a dock, de-consolidated and re-consolidated according to final delivery location requirements." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#463> a skos:Concept ;
    skos:prefLabel "463" ;
    rdfs:comment "Pre-packed cross docking despatch advice\n            Document by means of which the supplier or consignor informs the buyer, consignee or distribution centre about the despatch of products packed according to the final delivery point requirements which will be moved across a dock in a distribution centre without further handling." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#462> a skos:Concept ;
    skos:prefLabel "462" ;
    rdfs:comment "Ready for transshipment despatch advice\n            Document to advise that the goods ordered are ready for transshipment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#461> a skos:Concept ;
    skos:prefLabel "461" ;
    rdfs:comment "Payment card\n            The document is a credit, guarantee or charge card." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#460> a skos:Concept ;
    skos:prefLabel "460" ;
    rdfs:comment "Documentary credit application\n            Document/message whereby a bank is requested to issue a documentary credit on the conditions specified therein." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#459> a skos:Concept ;
    skos:prefLabel "459" ;
    rdfs:comment "Travel ticket\n            The document is a ticket giving access to a travel service." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#458> a skos:Concept ;
    skos:prefLabel "458" ;
    rdfs:comment "Reversal of credit\n            Reversal of credit accounting entry by bank." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#457> a skos:Concept ;
    skos:prefLabel "457" ;
    rdfs:comment "Reversal of debit\n            Reversal of debit accounting entry by bank." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#456> a skos:Concept ;
    skos:prefLabel "456" ;
    rdfs:comment "Debit advice\n            Advice on a debit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#455> a skos:Concept ;
    skos:prefLabel "455" ;
    rdfs:comment "Extended credit advice\n            Document/message sent by an account servicing institution to one of its account owners, to inform the account owner of an entry that has been or will be credited to its account for a specified amount on the date indicated. It provides extended commercial information concerning the relevant remittance advice." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#454> a skos:Concept ;
    skos:prefLabel "454" ;
    rdfs:comment "Credit advice\n            Document/message sent by an account servicing institution to one of its account owners, to inform the account owner of an entry which has been or will be credited to its account for a specified amount on the date indicated." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#453> a skos:Concept ;
    skos:prefLabel "453" ;
    rdfs:comment "Notice that circumstances prevent payment of delivered goods\n            Message used to inform a supplier that delivered goods cannot be paid due to circumstances which prevent payment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#452> a skos:Concept ;
    skos:prefLabel "452" ;
    rdfs:comment "Multiple payment order\n            Document/message containing a payment order to debit one or more accounts and to credit one or more beneficiaries." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#451> a skos:Concept ;
    skos:prefLabel "451" ;
    rdfs:comment "Extended payment order\n            Document/message containing information needed to initiate the payment. It may cover the financial settlement for several commercial trade transactions, which it is possible to specify in a special payments detail part. It is an instruction to the ordered bank to arrange for the payment of one specified amount to the beneficiary." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#450> a skos:Concept ;
    skos:prefLabel "450" ;
    rdfs:comment "Payment order\n            Document/message containing information needed to initiate the payment. It may cover the financial settlement for one or more commercial trade transactions. A payment order is an instruction to the ordered bank to arrange for the payment of one specified amount to the beneficiary." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#449> a skos:Concept ;
    skos:prefLabel "449" ;
    rdfs:comment "Identification match\n            Message related to conducting a search for an identification match." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#448> a skos:Concept ;
    skos:prefLabel "448" ;
    rdfs:comment "Documents presentation form\n            Document/message whereby a draft or similar instrument and/or commercial documents are presented to a bank for acceptance, discounting, negotiation, payment or collection, whether or not against a documentary credit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#447> a skos:Concept ;
    skos:prefLabel "447" ;
    rdfs:comment "Collection order\n            Document/message whereby a bank is instructed (or requested) to handle financial and/or commercial documents in order to obtain acceptance and/or payment, or to deliver documents on such other terms and conditions as may be specified." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#446> a skos:Concept ;
    skos:prefLabel "446" ;
    rdfs:comment "Request for price quote, specified end-customer\n            Document/message requesting price conditions under which goods are offered, provided that they are sold to the end-customer specified on the request for quote." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#445> a skos:Concept ;
    skos:prefLabel "445" ;
    rdfs:comment "Request for contract price and delivery quote\n            Document/message requesting contractual price conditions and contractual delivery conditions under which goods are offered." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#444> a skos:Concept ;
    skos:prefLabel "444" ;
    rdfs:comment "Request for contract price quote\n            Document/message requesting contractual price conditions under which goods are offered." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#443> a skos:Concept ;
    skos:prefLabel "443" ;
    rdfs:comment "Request for price and delivery quote\n            Document/message requesting price and delivery conditions under which goods are offered." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#442> a skos:Concept ;
    skos:prefLabel "442" ;
    rdfs:comment "Request for delivery quote\n            Document/message requesting delivery conditions under which goods are offered." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#441> a skos:Concept ;
    skos:prefLabel "441" ;
    rdfs:comment "Transport routing information\n            Document specifying the routes for transport between locations." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#440> a skos:Concept ;
    skos:prefLabel "440" ;
    rdfs:comment "Delivery point list.\n            A list of delivery point addresses." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#439> a skos:Concept ;
    skos:prefLabel "439" ;
    rdfs:comment "Request for price and delivery quote, ship and debit\n            Document/message from a distributor to a supplier requesting price conditions and delivery conditions under which goods can be sold by the distributor to the end-customer specified on the request for quote with compensation for loss of inventory value." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#438> a skos:Concept ;
    skos:prefLabel "438" ;
    rdfs:comment "Request for price quote, ship and debit\n            Document/message from a distributor to a supplier requesting price conditions under which goods can be sold by the distributor to the end-customer specified on the request for quote with compensation for loss of inventory value." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#437> a skos:Concept ;
    skos:prefLabel "437" ;
    rdfs:comment "Request for price and delivery quote, specified end-user\n            Document/message requesting price conditions and delivery conditions under which goods are offered, provided that they are sold to the end-customer specified on the request for quote." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#436> a skos:Concept ;
    skos:prefLabel "436" ;
    rdfs:comment "Transport equipment profile report\n            Report on the profile of transport equipment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#435> a skos:Concept ;
    skos:prefLabel "435" ;
    rdfs:comment "Preadvice of a credit\n            Preadvice indicating a credit to happen in the future." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#434> a skos:Concept ;
    skos:prefLabel "434" ;
    rdfs:comment "Notification of balance responsible entity change\n            Notification of a change of balance responsible entity." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#433> a skos:Concept ;
    skos:prefLabel "433" ;
    rdfs:comment "Notification to grid operator of metering point changes\n            Notification to the grid operator about changes regarding a metering point." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#432> a skos:Concept ;
    skos:prefLabel "432" ;
    rdfs:comment "Notification to grid operator of contract termination\n            Notification to the grid operator regarding the termination of a contract." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#431> a skos:Concept ;
    skos:prefLabel "431" ;
    rdfs:comment "Documentary credit letter of indemnity\n            Document/message in which a beneficiary of a documentary credit accepts responsibility for non-compliance with the terms and conditions of the credit, and undertakes to refund the money received under the credit, with interest and charges accrued." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#430> a skos:Concept ;
    skos:prefLabel "430" ;
    rdfs:comment "Banker's guarantee\n            Document/message in which a bank undertakes to pay out a limited amount of money to a designated party, on conditions stated therein (other than those laid down in the Uniform Customs Practice)." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#429> a skos:Concept ;
    skos:prefLabel "429" ;
    rdfs:comment "Application for banker's guarantee\n            Document/message whereby a customer requests his bank to issue a guarantee in favour of a nominated party in another country, stating the amount and currency and the specific conditions of the guarantee." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#428> a skos:Concept ;
    skos:prefLabel "428" ;
    rdfs:comment "Documentary credit negotiation advice\n            Document/message whereby a bank advises negotiation under a documentary credit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#427> a skos:Concept ;
    skos:prefLabel "427" ;
    rdfs:comment "Documentary credit acceptance advice\n            Document/message whereby a bank advises acceptance under a documentary credit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#426> a skos:Concept ;
    skos:prefLabel "426" ;
    rdfs:comment "Documentary credit payment advice\n            Document/message whereby a bank advises payment under a documentary credit." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#425> a skos:Concept ;
    skos:prefLabel "425" ;
    rdfs:comment "Collection payment advice\n            Document/message whereby a bank advises that a collection has been paid, giving details and methods of funds disposal." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#424> a skos:Concept ;
    skos:prefLabel "424" ;
    rdfs:comment "WCO first step of two-step export declaration\n            First part of a simplified declaration, in accordance with the WCO Customs Data Model, to Customs by which goods are declared for Customs export procedure based on the 1999 Kyoto Convention." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#423> a skos:Concept ;
    skos:prefLabel "423" ;
    rdfs:comment "WCO one-step export declaration\n            Single step declaration, in accordance with the WCO Customs Data Model, to Customs by which goods are declared for a Customs export procedure based on the 1999 Kyoto Convention." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#422> a skos:Concept ;
    skos:prefLabel "422" ;
    rdfs:comment "WCO Cargo Report Import, Air or Maritime\n            Declaration, in accordance with the WCO Customs Data Model, to Customs concerning the import of cargo carried by commercial means of transport over water or through the air, e.g. vessel or aircraft." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#421> a skos:Concept ;
    skos:prefLabel "421" ;
    rdfs:comment "WCO Cargo Report Import, Rail or Road\n            Declaration, in accordance with the WCO Customs Data Model, to Customs concerning the import of cargo carried by commercial means of transport over land, e.g. truck or train." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#420> a skos:Concept ;
    skos:prefLabel "420" ;
    rdfs:comment "Optical Character Reading (OCR) payment credit note\n            Payment credit note effected by an Optical Character Reading (OCR) document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#419> a skos:Concept ;
    skos:prefLabel "419" ;
    rdfs:comment "WCO Cargo Report Export, Air or Maritime\n            Declaration, in accordance with the WCO Customs Data Model, to Customs concerning the export of cargo carried by commercial means of transport over water or through the air, e.g. vessel or aircraft." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#418> a skos:Concept ;
    skos:prefLabel "418" ;
    rdfs:comment "WCO Cargo Report Export, Rail or Road\n            Declaration, in accordance with the WCO Customs Data Model, to Customs concerning the export of cargo carried by commercial means of transport over land, e.g. truck or train." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#417> a skos:Concept ;
    skos:prefLabel "417" ;
    rdfs:comment "Farmyard manure analysis\n            Farmyard manure analysis document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#416> a skos:Concept ;
    skos:prefLabel "416" ;
    rdfs:comment "Soil analysis\n            Soil analysis document." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#415> a skos:Concept ;
    skos:prefLabel "415" ;
    rdfs:comment "Data Plot Sheet\n            Document/Message providing technical description and information of the crop production." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#414> a skos:Concept ;
    skos:prefLabel "414" ;
    rdfs:comment "Acknowledgement of change of supplier\n            Acknowledgement of the change of supplier." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#413> a skos:Concept ;
    skos:prefLabel "413" ;
    rdfs:comment "Infrastructure condition\n            Information about components in an infrastructure." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#412> a skos:Concept ;
    skos:prefLabel "412" ;
    rdfs:comment "Application for banker's draft\n            Application by a customer to his bank to issue a banker's draft stating the amount and currency of the draft, the name of the payee and the place and country of payment." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#411> a skos:Concept ;
    skos:prefLabel "411" ;
    rdfs:comment "Utilities time series message\n            The Utilities time series message is sent between responsible parties in a utilities infrastructure for the purpose of reporting time series and connected technical and/or administrative information." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#410> a skos:Concept ;
    skos:prefLabel "410" ;
    rdfs:comment "Notification of metering point identification change\n            Notification of the change of metering point identification." ;
    skos:inScheme hilo:DocumentName  .

<https://hilosemantics.com/DocumentName#409> a skos:Concept ;
