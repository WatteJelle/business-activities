    skos:prefLabel "ADZ" ;
    rdfs:comment "IGC Code\n            The International Code of the Construction and Equipment of Ships Carrying Liquefied Gases in Bulk" ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#ADY> a skos:Concept ;
    skos:prefLabel "ADY" ;
    rdfs:comment "IBC Code\n            The international Code for the Construction and Equipment of Ships carrying Dangerous Chemicals in Bulk" ;
    skos:inScheme hilo:Dangerousgoodsregulationcodes  .

<https://hilosemantics.com/Dangerousgoodsregulationcodes#ADX> a skos:Concept ;
    skos:prefLabel "ADX" ;
    rdfs:comment "Transport emergency (TREM) card\n            A card providing details on procedures for emergencies during transportation according to ADR." ;
