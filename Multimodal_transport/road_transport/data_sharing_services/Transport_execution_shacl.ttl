# SHACL constraints for data sharing service: Transport execution
hilo:Visibility-1774610568416Shape a sh:NodeShape ;
    sh:targetNode hilo:Visibility-1774610568416 ;
    rdfs:label "Transport execution service shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/startStateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue hilo:Loaded-1774610656332 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/endStateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath <https://hilosemantics.com/stateServ> ] ;
        sh:minCount 2 ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath <https://hilosemantics.com/transServ> ] ;
        sh:minCount 3 ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath <https://hilosemantics.com/eventServ> ] ;
        sh:minCount 3 ;
    ]  .

hilo:Visibility-1774610568416StateShape a sh:NodeShape ;
    sh:targetClass <https://hilosemantics.com/State> ;
    rdfs:label "Transport execution state shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/stateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ]  .

hilo:Visibility-1774610568416StateTransitionShape a sh:NodeShape ;
    sh:targetClass <https://hilosemantics.com/Statetransition> ;
    rdfs:label "Transport execution state transition shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/inputState> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/outputState> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/trigger> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/transServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ]  .

hilo:Visibility-1774610568416DataSharingEventShape a sh:NodeShape ;
    sh:targetClass <https://hilosemantics.com/DataSharingEvent> ;
