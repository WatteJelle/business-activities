# SHACL constraints for data sharing service: Transport ordering
hilo:Ordering-1774610547520Shape a sh:NodeShape ;
    sh:targetNode hilo:Ordering-1774610547520 ;
    rdfs:label "Transport ordering service shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/startStateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue hilo:Contract-1774610781686 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/endStateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue hilo:Loaded-1774610656332 ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath <https://hilosemantics.com/stateServ> ] ;
        sh:minCount 3 ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath <https://hilosemantics.com/transServ> ] ;
        sh:minCount 2 ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath <https://hilosemantics.com/eventServ> ] ;
        sh:minCount 2 ;
    ]  .

hilo:Ordering-1774610547520StateShape a sh:NodeShape ;
    sh:targetClass <https://hilosemantics.com/State> ;
    rdfs:label "Transport ordering state shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/stateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ]  .

hilo:Ordering-1774610547520StateTransitionShape a sh:NodeShape ;
    sh:targetClass <https://hilosemantics.com/Statetransition> ;
    rdfs:label "Transport ordering state transition shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/inputState> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/outputState> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/trigger> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/transServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ]  .

hilo:Ordering-1774610547520DataSharingEventShape a sh:NodeShape ;
    sh:targetClass <https://hilosemantics.com/DataSharingEvent> ;
    rdfs:label "Transport ordering data sharing event shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/eventServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ]  .

