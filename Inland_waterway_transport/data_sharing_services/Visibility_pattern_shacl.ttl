# SHACL constraints for data sharing service: Visibility pattern
hilo:VisibilityService-1792831324863_InlandwaterwaytransportShape a sh:NodeShape ;
    sh:targetNode hilo:VisibilityService-1792831324863_Inlandwaterwaytransport ;
    rdfs:label "Visibility pattern service shape" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/startStateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue hilo:Orderconfirmed-1792833586306 ;
    ] ;
    sh:property [
        sh:path <https://hilosemantics.com/endStateServ> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue hilo:Cargodelivered-1792832509475 ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath <https://hilosemantics.com/stateServ> ] ;
        sh:minCount 7 ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath <https://hilosemantics.com/transServ> ] ;
        sh:minCount 7 ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath <https://hilosemantics.com/eventServ> ] ;
        sh:minCount 8 ;
    ]  .

